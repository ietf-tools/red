{
  "name": "red",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "npx --no nuxt analyze",
    "build": "npm run build:nuxt",
    "build:nuxt": "npx --no nuxt build",
    "build:dev": "npm run build:nuxt:dev",
    "build:nuxt:dev": "npx --no nuxt prepare && npx --no nuxt build --envName development",
    "dev": "npm run dev:nuxt",
    "dev:nuxt": "nuxt dev",
    "cleanup": "nuxt cleanup",
    "preview": "npm run build:nuxt && nuxt preview",
    "preview:dev": "npm run build:nuxt:dev && nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "TZ=UTC npm run test:unittests && npm run test:types && npm run test:lint",
    "test:lint": "oxlint",
    "test:lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "test:types": "nuxt prepare && vue-tsc -b --noEmit",
    "test:unittests": "TZ=UTC vitest run --project unit",
    "test:unittests:watch": "TZ=UTC vitest --project unit",
    "test:e2e": "TZ=UTC vitest run --project e2e",
    "test:e2e:watch": "TZ=UTC vitest --project e2e",
    "generate:content-metadata": "node ./scripts/generate-content-metadata.ts"
  },
  "dependencies": {
    "@internationalized/date": "3.12.2",
    "@opentelemetry/auto-instrumentations-web": "0.65.0",
    "@opentelemetry/context-zone": "2.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/instrumentation": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-trace-web": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@pinia/nuxt": "0.11.3",
    "@tailwindcss/vite": "4.3.2",
    "@vueuse/core": "14.3.0",
    "better-sqlite3": "12.11.1",
    "commander": "15.0.0",
    "core-js": "3.49.0",
    "es-toolkit": "1.49.0",
    "luxon": "3.7.2",
    "micromark": "4.0.2",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "nitropack": "2.13.4",
    "nuxt": "4.4.8",
    "nuxt-vitalizer": "2.0.0",
    "pinia-plugin-persistedstate": "4.7.1",
    "postcss-nested-import": "1.3.0",
    "reka-ui": "2.10.1",
    "simple-git": "3.36.0",
    "tailwindcss": "4.3.2",
    "typesense-instantsearch-adapter": "3.0.2",
    "vue": "3.5.39",
    "vue-instantsearch": "4.27.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.2",
    "@nuxt/test-utils": "4.0.3",
    "@playwright/test": "1.61.1",
    "@types/luxon": "3.7.2",
    "@vue/test-utils": "2.4.11",
    "fast-xml-parser": "5.9.3",
    "happy-dom": "20.10.6",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "playwright": "1.61.1",
    "playwright-core": "1.61.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  }
}
