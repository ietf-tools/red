{
  // The deployment smoke suite runs under the Playwright runner with no Nuxt context, so it isn't
  // covered by any of the generated .nuxt/tsconfig.*.json projects. This project exists so
  // `npm run test:types` typechecks it. `lib` includes DOM for the `page.evaluate` callbacks,
  // which execute in the browser.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    // Relative imports carry explicit `.ts` extensions, matching e2e/search-index/ — required for
    // `node ./smoke/login.ts` to resolve them, since Node's TypeScript support does no
    // extensionless resolution.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
