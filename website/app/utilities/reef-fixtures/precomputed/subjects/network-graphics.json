    "rfc2083": {
      "title": "PNG (Portable Network Graphics) Specification Version 1.0",
      "subseries": [],
      "status": "hist",
      "status_name": "historic",
      "stream": "Legacy",
      "stream_name": "Legacy",
      "obsoletes": [],
      "obsoleted_by": [],
      "updates": [],
      "updated_by": [],
      "authors": ["T. Boutell"],
      "published": "1997-03-01",
      "identifiers": [{ "type": "doi", "value": "10.17487/RFC2083" }],
      "area": null,
      "group": { "acronym": "none", "name": "Individual Submissions" },
      "keywords": ["PNG", "file", "format", "bitmap"],
      "pages": 102,
      "abstract": "This document describes PNG (Portable Network Graphics), an extensible file format for the lossless, portable, well-compressed storage of raster images. PNG provides a patent-free replacement for GIF and can also replace many common uses of TIFF. Indexed-color, grayscale, and truecolor images are supported, plus an optional alpha channel. Sample depths range from 1 to 16 bits.\n\n PNG is designed to work well in online viewing applications, such as the World Wide Web, so it is fully streamable with a progressive display option. PNG is robust, providing both full file integrity checking and simple detection of common transmission errors. Also, PNG can store gamma and chromaticity data for improved color matching on heterogeneous platforms.\n\n This specification defines the Internet Media Type image/png."
    },
