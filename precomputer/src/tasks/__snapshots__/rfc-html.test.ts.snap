                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-19.19-6.5",
                          },
                          "children": [
                            {
                              "textContent": "Reason Phrase Length:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
