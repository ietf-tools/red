                    "href": "#section-17",
                  },
                  "children": [
                    {
                      "textContent": "17. ",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "attributes": {
                    "class": "section-name selfRef",
                    "href": "#name-packet-formats",
                  },
                  "children": [
                    {
                      "textContent": "Packet Formats",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": "
      ",
                  "type": "Text",
                },
              ],
              "nodeName": "h2",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-17-1",
              },
              "children": [
                {
                  "textContent": "All numeric values are encoded in network byte order (that is, big endian), and
all field sizes are in bits.  Hexadecimal notation is used for describing the
value of fields.",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-17-1",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "packet-encoding",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-17.1",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-packet-number-encoding-and-",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-17.1",
                          },
                          "children": [
                            {
                              "textContent": "17.1. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-packet-number-encoding-and-",
                          },
                          "children": [
                            {
                              "textContent": "Packet Number Encoding and Decoding",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.1-1",
                      },
                      "children": [
                        {
                          "textContent": "Packet numbers are integers in the range 0 to 2",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "62",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "sup",
                          "type": "Element",
                        },
                        {
                          "textContent": "-1
(",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-numbers",
                          },
                          "children": [
                            {
                              "textContent": "Section 12.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ").  When present in long or short packet headers, they are
encoded in 1 to 4 bytes.  The number of bits required to represent the packet
number is reduced by including only the least significant bits of the packet
number.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.1-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.1-2",
                      },
                      "children": [
                        {
                          "textContent": "The encoded packet number is protected as described in
",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "attributes": {
                                "class": "relref",
                                "href": "/info/rfc9001/#section-5.4",
                              },
                              "children": [
                                {
                                  "textContent": "Section 5.4",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": " of [",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#QUIC-TLS",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC-TLS",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.1-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.1-3",
                      },
                      "children": [
                        {
                          "textContent": "Prior to receiving an acknowledgment for a packet number space, the full packet
number ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be included; it is not to be truncated, as described below.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.1-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.1-4",
                      },
                      "children": [
                        {
                          "textContent": "After an acknowledgment is received for a packet number space, the sender ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "
use a packet number size able to represent more than twice as large a range as
the difference between the largest acknowledged packet number and the packet
number being sent.  A peer receiving the packet will then correctly decode the
packet number, unless the packet is delayed in transit such that it arrives
after many higher-numbered packets have been received.  An endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " use a
large enough packet number encoding to allow the packet number to be recovered
even if the packet arrives after packets that are sent afterwards.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.1-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.1-5",
                      },
                      "children": [
                        {
                          "textContent": "As a result, the size of the packet number encoding is at least one bit more
than the base-2 logarithm of the number of contiguous unacknowledged packet
numbers, including the new packet.  Pseudocode and an example for packet number
encoding can be found in ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#sample-packet-number-encoding",
                          },
                          "children": [
                            {
                              "textContent": "Appendix A.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.1-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.1-6",
                      },
                      "children": [
                        {
                          "textContent": "At a receiver, protection of the packet number is removed prior to recovering
the full packet number. The full packet number is then reconstructed based on
the number of significant bits present, the value of those bits, and the largest
packet number received in a successfully authenticated packet. Recovering the
full packet number is necessary to successfully complete the removal of packet
protection.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.1-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.1-7",
                      },
                      "children": [
                        {
                          "textContent": "Once header protection is removed, the packet number is decoded by finding the
packet number value that is closest to the next expected packet.  The next
expected packet is the highest received packet number plus one.  Pseudocode and
an example for packet number decoding can be found in
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#sample-packet-number-decoding",
                          },
                          "children": [
                            {
                              "textContent": "Appendix A.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.1-7",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "long-header",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-17.2",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-long-header-packets",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-17.2",
                          },
                          "children": [
                            {
                              "textContent": "17.2. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-long-header-packets",
                          },
                          "children": [
                            {
                              "textContent": "Long Header Packets",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-long-header-packet-format",
                      },
                      "children": [],
                      "nodeName": "span",
                      "type": "Element",
                    },
                    {
                      "attributes": {
                        "id": "fig-long-header",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "figure-13",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "artwork art-text alignLeft",
                                "id": "section-17.2-1.1",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "data-component": "HorizontalScrollable",
                                  },
                                  "children": [
                                    {
                                      "attributes": {},
                                      "children": [
                                        {
                                          "textContent": "Long Header Packet {
  Header Form (1) = 1,
  Fixed Bit (1) = 1,
  Long Packet Type (2),
  Type-Specific Bits (4),
  Version (32),
  Destination Connection ID Length (8),
  Destination Connection ID (0..160),
  Source Connection ID Length (8),
  Source Connection ID (0..160),
  Type-Specific Payload (..),
}
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "pre",
                                      "type": "Element",
                                    },
                                  ],
                                  "nodeName": "div",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [
                                {
                                  "attributes": {
                                    "class": "selfRef",
                                    "href": "#figure-13",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Figure 13",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ":
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "selfRef",
                                    "href": "#name-long-header-packet-format",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Long Header Packet Format",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "figcaption",
                              "type": "Element",
                            },
                          ],
                          "nodeName": "figure",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.2-2",
                      },
                      "children": [
                        {
                          "textContent": "Long headers are used for packets that are sent prior to the establishment
of 1-RTT keys. Once 1-RTT keys are available,
a sender switches to sending packets using the short header
(",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#short-header",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ").  The long form allows for special packets -- such as the
Version Negotiation packet -- to be represented in this uniform fixed-length
packet format. Packets that use the long header contain the following fields:",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.2-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "class": "break",
                      },
                      "children": [],
                      "nodeName": "span",
                      "type": "Element",
                    },
                    {
                      "attributes": {
                        "class": "dlParallel",
                        "id": "section-17.2-3",
                      },
                      "children": [
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-3.1",
                          },
                          "children": [
                            {
                              "textContent": "Header Form:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-3.2",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2-3.2.1",
                              },
                              "children": [
                                {
                                  "textContent": "The most significant bit (0x80) of byte 0 (the first byte) is set to 1 for
long headers.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2-3.2.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-3.3",
                          },
                          "children": [
                            {
                              "textContent": "Fixed Bit:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-3.4",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2-3.4.1",
                              },
                              "children": [
                                {
                                  "textContent": "The next bit (0x40) of byte 0 is set to 1, unless the packet is a Version
Negotiation packet.  Packets containing a zero value for this bit are not
valid packets in this version and ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be discarded.  A value of 1 for this
bit allows QUIC to coexist with other protocols; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "[",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#RFC7983",
                                      },
                                      "children": [
                                        {
                                          "textContent": "RFC7983",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2-3.4.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-3.5",
                          },
                          "children": [
                            {
                              "textContent": "Long Packet Type:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-3.6",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2-3.6.1",
                              },
                              "children": [
                                {
                                  "textContent": "The next two bits (those with a mask of 0x30) of byte 0 contain a packet type.
Packet types are listed in ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#long-packet-types",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Table 5",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2-3.6.1",
                                  },
