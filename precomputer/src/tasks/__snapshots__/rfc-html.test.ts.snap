          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.5-1",
                              },
                              "children": [
                                {
                                  "textContent": "As shown in ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#retry-format",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Figure 18",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ", a Retry packet uses a long packet header with a
type value of 0x03. It carries an address validation token created by the
server. It is used by a server that wishes to perform a retry; see
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#validate-handshake",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 8.1",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
