                    {
                      "attributes": {
                        "id": "section-19.15-1",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint sends a NEW",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
