                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-1.3-4.11",
                          },
                          "children": [
                            {
                              "textContent": "[x (L)]:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-1.3-4.12",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-1.3-4.12.1",
                              },
                              "children": [
                                {
                                  "textContent": "Indicates that x is optional and has a length of L",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-1.3-4.12.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
