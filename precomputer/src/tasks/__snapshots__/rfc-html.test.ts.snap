                      "attributes": {
                        "id": "section-22.3-7",
                      },
                      "children": [
                        {
                          "textContent": "Each value of the form ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "31 * N + 27",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "code",
                          "type": "Element",
                        },
                        {
                          "textContent": " for integer values of N (that is, 27, 58,
89, ...) are reserved; these values ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be assigned by IANA and ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "
appear in the listing of assigned values.",
                          "type": "Text",
                        },
                        {
