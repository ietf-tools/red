                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-18-6",
              },
              "children": [
                {
                  "textContent": "QUIC encodes transport parameters into a sequence of bytes, which is then
included in the cryptographic handshake.",
                  "type": "Text",
                },
                {
