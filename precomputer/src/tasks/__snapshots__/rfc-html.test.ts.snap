                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-1.3-4.14.1",
                              },
                              "children": [
                                {
                                  "textContent": "Indicates that x is repeated zero or more times and that each instance has a
length of L",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-1.3-4.14.1",
                                  },
