              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "section-name selfRef",
                    "href": "#name-copyright-notice",
                  },
                  "children": [
                    {
                      "textContent": "Copyright Notice",
                      "type": "Text",
                    },
