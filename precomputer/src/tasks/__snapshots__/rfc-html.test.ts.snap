                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-19.9-6",
                      },
                      "children": [
                        {
                          "textContent": "All data sent in STREAM frames counts toward this limit.  The sum of the final
sizes on all streams -- including streams in terminal states -- ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " exceed
the value advertised by a receiver.  An endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " terminate a connection
with an error of type FLOW",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_CONTROL",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_ERROR",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " if it receives more data than the
maximum data value that it has sent.  This includes violations of remembered
limits in Early Data; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#zerortt-parameters",
                          },
                          "children": [
