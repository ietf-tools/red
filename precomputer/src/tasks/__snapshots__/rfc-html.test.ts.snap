                                "id": "section-19.9-5.2.1",
                              },
                              "children": [
                                {
                                  "textContent": "A variable-length integer indicating the maximum amount of data that can be
sent on the entire connection, in units of bytes.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.9-5.2.1",
                                  },
