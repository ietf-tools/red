                            },
                            {
                              "attributes": {
                                "id": "section-18.2-6.2.1",
                              },
                              "children": [
                                {
                                  "textContent": "This is an integer value specifying the maximum number of connection IDs from
the peer that an endpoint is willing to store. This value includes the
connection ID received during the handshake, that received in the
preferred",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
