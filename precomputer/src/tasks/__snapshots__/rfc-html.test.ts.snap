                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.2-6",
                      },
                      "children": [
                        {
                          "textContent": "The header form bit, Destination and Source Connection ID lengths, Destination
and Source Connection ID fields, and Version fields of a long header packet are
version independent. The other fields in the first byte are version specific.
See ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#QUIC-INVARIANTS",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC-INVARIANTS",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " for details on how packets from different versions of
QUIC are interpreted.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.2-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.2-7",
                      },
                      "children": [
                        {
                          "textContent": "The interpretation of the fields and the payload are specific to a version and
packet type.  While type-specific semantics for this version are described in
the following sections, several long header packets in this version of QUIC
contain these additional fields:",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.2-7",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "class": "break",
                      },
                      "children": [],
                      "nodeName": "span",
                      "type": "Element",
                    },
                    {
                      "attributes": {
                        "class": "dlParallel",
                        "id": "section-17.2-8",
                      },
                      "children": [
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-8.1",
                          },
                          "children": [
                            {
                              "textContent": "Reserved Bits:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-8.2",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2-8.2.1",
                              },
                              "children": [
                                {
                                  "textContent": "Two bits (those with a mask of 0x0c) of byte 0 are reserved across multiple
packet types.  These bits are protected using header protection; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc9001/#section-5.4",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 5.4",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#QUIC-TLS",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC-TLS",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ". The value included prior to protection ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be set to 0.
An endpoint ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " treat receipt of a packet that has a non-zero value for these
bits after removing both packet and header protection as a connection error
of type PROTOCOL",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "_VIOLATION",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " Discarding such a packet after only removing
header protection can expose the endpoint to attacks; see
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc9001/#section-9.5",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 9.5",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#QUIC-TLS",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC-TLS",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2-8.2.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-8.3",
                          },
                          "children": [
                            {
                              "textContent": "Packet Number Length:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-8.4",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2-8.4.1",
                              },
                              "children": [
                                {
                                  "textContent": "In packet types that contain a Packet Number field, the least significant two
bits (those with a mask of 0x03) of byte 0 contain the length of the Packet
Number field, encoded as an unsigned two-bit integer that is one less than the
length of the Packet Number field in bytes.  That is, the length of the Packet
Number field is the value of this field plus one.  These bits are protected
using header protection; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc9001/#section-5.4",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 5.4",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#QUIC-TLS",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC-TLS",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2-8.4.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-8.5",
                          },
                          "children": [
                            {
                              "textContent": "Length:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-8.6",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2-8.6.1",
                              },
                              "children": [
                                {
                                  "textContent": "This is the length of the remainder of the packet (that is, the Packet Number
and Payload fields) in bytes, encoded as a variable-length integer
(",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#integer-encoding",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 16",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ").",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2-8.6.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-8.7",
                          },
                          "children": [
                            {
                              "textContent": "Packet Number:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-8.8",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2-8.8.1",
                              },
                              "children": [
                                {
                                  "textContent": "This field is 1 to 4 bytes long. The packet number is protected using header
protection; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc9001/#section-5.4",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 5.4",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#QUIC-TLS",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC-TLS",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  The length of the Packet Number
field is encoded in the Packet Number Length bits of byte 0; see above.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2-8.8.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-8.9",
                          },
                          "children": [
                            {
                              "textContent": "Packet Payload:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2-8.10",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2-8.10.1",
                              },
                              "children": [
                                {
                                  "textContent": "This is the payload of the packet -- containing a sequence of frames -- that
is protected using packet protection.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2-8.10.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "dl",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "packet-version",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2.1",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-version-negotiation-packet",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-17.2.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "17.2.1. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-version-negotiation-packet",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Version Negotiation Packet",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-1",
                              },
                              "children": [
                                {
                                  "textContent": "A Version Negotiation packet is inherently not version specific. Upon receipt by
a client, it will be identified as a Version Negotiation packet based on the
Version field having a value of 0.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-2",
                              },
                              "children": [
                                {
                                  "textContent": "The Version Negotiation packet is a response to a client packet that contains a
version that is not supported by the server.  It is only sent by servers.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-3",
                              },
                              "children": [
                                {
                                  "textContent": "The layout of a Version Negotiation packet is:",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-version-negotiation-packet-2",
                              },
                              "children": [],
                              "nodeName": "span",
                              "type": "Element",
                            },
                            {
                              "attributes": {
                                "id": "version-negotiation-format",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "figure-14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "artwork art-text alignLeft",
                                        "id": "section-17.2.1-4.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "data-component": "HorizontalScrollable",
                                          },
                                          "children": [
                                            {
                                              "attributes": {},
                                              "children": [
                                                {
                                                  "textContent": "Version Negotiation Packet {
  Header Form (1) = 1,
  Unused (7),
  Version (32) = 0,
  Destination Connection ID Length (8),
  Destination Connection ID (0..2040),
  Source Connection ID Length (8),
  Source Connection ID (0..2040),
  Supported Version (32) ...,
}
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "pre",
                                              "type": "Element",
                                            },
                                          ],
                                          "nodeName": "div",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {},
                                      "children": [
                                        {
                                          "attributes": {
                                            "class": "selfRef",
                                            "href": "#figure-14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Figure 14",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ":
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "selfRef",
                                            "href": "#name-version-negotiation-packet-2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Version Negotiation Packet",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
            ",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "figcaption",
                                      "type": "Element",
                                    },
                                  ],
                                  "nodeName": "figure",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-5",
                              },
                              "children": [
                                {
                                  "textContent": "The value in the Unused field is set to an arbitrary value by the server.
Clients ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " ignore the value of this field.  Where QUIC might be multiplexed
with other protocols (see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "[",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#RFC7983",
                                      },
                                      "children": [
                                        {
                                          "textContent": "RFC7983",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "), servers ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " set the most significant
bit of this field (0x40) to 1 so that Version Negotiation packets appear to have
the Fixed Bit field.  Note that other versions of QUIC might not make a similar
recommendation.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-6",
                              },
                              "children": [
                                {
                                  "textContent": "The Version field of a Version Negotiation packet ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be set to 0x00000000.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-6",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-7",
                              },
                              "children": [
                                {
                                  "textContent": "The server ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " include the value from the Source Connection ID field of the
packet it receives in the Destination Connection ID field.  The value for Source
Connection ID ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be copied from the Destination Connection ID of the received
packet, which is initially randomly selected by a client.  Echoing both
connection IDs gives clients some assurance that the server received the packet
and that the Version Negotiation packet was not generated by an entity that
did not observe the Initial packet.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-7",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-8",
                              },
                              "children": [
                                {
                                  "textContent": "Future versions of QUIC could have different requirements for the lengths of
connection IDs. In particular, connection IDs might have a smaller minimum
length or a greater maximum length.  Version",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "-specific",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " rules for the connection
ID therefore ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST NOT",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " influence a decision about whether to send a Version
Negotiation packet.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-8",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-9",
                              },
                              "children": [
                                {
                                  "textContent": "The remainder of the Version Negotiation packet is a list of 32-bit versions
that the server supports.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-9",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-10",
                              },
                              "children": [
                                {
                                  "textContent": "A Version Negotiation packet is not acknowledged.  It is only sent in response
to a packet that indicates an unsupported version; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#server-pkt-handling",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 5.2.2",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-10",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-11",
                              },
                              "children": [
                                {
                                  "textContent": "The Version Negotiation packet does not include the Packet Number and Length
fields present in other packets that use the long header form.  Consequently,
a Version Negotiation packet consumes an entire UDP datagram.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-11",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-12",
                              },
                              "children": [
                                {
                                  "textContent": "A server ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST NOT",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " send more than one Version Negotiation packet in response to a
single UDP datagram.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-12",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.1-13",
                              },
                              "children": [
                                {
                                  "textContent": "See ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#version-negotiation",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 6",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " for a description of the version negotiation
process.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.1-13",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "packet-initial",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2.2",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-initial-packet",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-17.2.2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "17.2.2. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-initial-packet",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Initial Packet",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.2-1",
                              },
                              "children": [
                                {
                                  "textContent": "An Initial packet uses long headers with a type value of 0x00.  It carries the
first CRYPTO frames sent by the client and server to perform key exchange, and
it carries ACK frames in either direction.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.2-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-initial-packet-2",
                              },
                              "children": [],
                              "nodeName": "span",
                              "type": "Element",
                            },
                            {
                              "attributes": {
                                "id": "initial-format",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "figure-15",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "artwork art-text alignLeft",
                                        "id": "section-17.2.2-2.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "data-component": "HorizontalScrollable",
                                          },
                                          "children": [
                                            {
                                              "attributes": {},
                                              "children": [
                                                {
                                                  "textContent": "Initial Packet {
  Header Form (1) = 1,
  Fixed Bit (1) = 1,
  Long Packet Type (2) = 0,
  Reserved Bits (2),
  Packet Number Length (2),
  Version (32),
  Destination Connection ID Length (8),
  Destination Connection ID (0..160),
  Source Connection ID Length (8),
  Source Connection ID (0..160),
  Token Length (i),
  Token (..),
  Length (i),
  Packet Number (8..32),
  Packet Payload (8..),
}
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "pre",
                                              "type": "Element",
                                            },
                                          ],
                                          "nodeName": "div",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {},
                                      "children": [
                                        {
                                          "attributes": {
                                            "class": "selfRef",
                                            "href": "#figure-15",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Figure 15",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ":
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "selfRef",
                                            "href": "#name-initial-packet-2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Initial Packet",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
            ",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "figcaption",
                                      "type": "Element",
                                    },
                                  ],
                                  "nodeName": "figure",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.2-3",
                              },
                              "children": [
                                {
                                  "textContent": "The Initial packet contains a long header as well as the Length and Packet
Number fields; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#long-header",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  The first byte contains the Reserved and
Packet Number Length bits; see also ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#long-header",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  Between the Source
Connection ID and Length fields, there are two additional fields specific to
the Initial packet.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.2-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "break",
                              },
                              "children": [],
                              "nodeName": "span",
                              "type": "Element",
                            },
                            {
                              "attributes": {
                                "class": "dlParallel",
                                "id": "section-17.2.2-4",
                              },
                              "children": [
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.2-4.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Token Length:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.2-4.2",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.2-4.2.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A variable-length integer specifying the length of the Token field, in bytes.
This value is 0 if no token is present.  Initial packets sent by the server
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " set the Token Length field to 0; clients that receive an Initial
packet with a non-zero Token Length field ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " either discard the packet or
generate a connection error of type PROTOCOL",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [],
                                          "nodeName": "wbr",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "_VIOLATION",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [],
                                          "nodeName": "wbr",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [],
                                          "nodeName": "wbr",
                                          "type": "Element",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.2-4.2.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.2-4.3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Token:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.2-4.4",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.2-4.4.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The value of the token that was previously provided in a Retry packet or
NEW_TOKEN frame; see ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#validate-handshake",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 8.1",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.2-4.4.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "dl",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.2-5",
                              },
                              "children": [
                                {
                                  "textContent": "In order to prevent tampering by version-unaware middleboxes, Initial packets
are protected with connection- and version",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "-specific",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " keys (Initial keys) as
described in ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "[",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#QUIC-TLS",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC-TLS",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  This protection does not provide confidentiality or
integrity against attackers that can observe packets, but it does prevent
attackers that cannot observe packets from spoofing Initial packets.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.2-5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.2-6",
                              },
                              "children": [
                                {
                                  "textContent": "The client and server use the Initial packet type for any packet that contains
an initial cryptographic handshake message. This includes all cases where a new
packet containing the initial cryptographic message needs to be created, such as
the packets sent after receiving a Retry packet; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#packet-retry",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2.5",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.2-6",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.2-7",
                              },
                              "children": [
                                {
                                  "textContent": "A server sends its first Initial packet in response to a client Initial.  A
server ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " send multiple Initial packets.  The cryptographic key exchange could
require multiple round trips or retransmissions of this data.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.2-7",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.2-8",
                              },
                              "children": [
                                {
                                  "textContent": "The payload of an Initial packet includes a CRYPTO frame (or frames) containing
a cryptographic handshake message, ACK frames, or both.  PING, PADDING, and
CONNECTION",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "_CLOSE",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " frames of type 0x1c are also permitted.  An endpoint that
receives an Initial packet containing other frames can either discard the
packet as spurious or treat it as a connection error.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.2-8",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.2-9",
                              },
                              "children": [
                                {
                                  "textContent": "The first packet sent by a client always includes a CRYPTO frame that contains
the start or all of the first cryptographic handshake message.  The first
CRYPTO frame sent always begins at an offset of 0; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#handshake",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 7",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.2-9",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.2-10",
                              },
                              "children": [
                                {
                                  "textContent": "Note that if the server sends a TLS Hello",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "Retry",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "Request",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " (see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc9001/#section-4.7",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 4.7",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#QUIC-TLS",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC-TLS",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "), the client will send another series of Initial packets. These
Initial packets will continue the cryptographic handshake and will contain
CRYPTO frames starting at an offset matching the size of the CRYPTO frames sent
in the first flight of Initial packets.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.2-10",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "discard-initial",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.2.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "name-abandoning-initial-packets",
                                      },
                                      "children": [
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-number selfRef",
                                            "href": "#section-17.2.2.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "17.2.2.1. ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-name selfRef",
                                            "href": "#name-abandoning-initial-packets",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Abandoning Initial Packets",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
            ",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "h5",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.2.1-1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A client stops both sending and processing Initial packets when it sends its
first Handshake packet.  A server stops sending and processing Initial packets
when it receives its first Handshake packet.  Though packets might still be in
flight or awaiting acknowledgment, no further Initial packets need to be
exchanged beyond this point.  Initial packet protection keys are discarded (see
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "attributes": {
                                                "class": "relref",
                                                "href": "/info/rfc9001/#section-4.9.1",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Section 4.9.1",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": " of [",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#QUIC-TLS",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "QUIC-TLS",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ") along with any loss recovery and congestion
control state; see ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "attributes": {
                                                "class": "relref",
                                                "href": "/info/rfc9002/#section-6.4",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Section 6.4",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": " of [",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#QUIC-RECOVERY",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "QUIC-RECOVERY",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.2.1-1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.2.1-2",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Any data in CRYPTO frames is discarded -- and no longer retransmitted -- when
Initial keys are discarded.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.2.1-2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "section",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "packet-0rtt",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.2.3",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-0-rtt",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-17.2.3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "17.2.3. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-0-rtt",
                                  },
                                  "children": [
                                    {
                                      "textContent": "0-RTT",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.3-1",
                              },
                              "children": [
                                {
                                  "textContent": "A 0-RTT packet uses long headers with a type value of 0x01, followed by the
Length and Packet Number fields; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#long-header",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  The first byte contains
the Reserved and Packet Number Length bits; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#long-header",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  A 0-RTT packet
is used to carry "early" data from the client to the server as part of the
first flight, prior to handshake completion.  As part of the TLS handshake, the
server can accept or reject this early data.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.3-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.3-2",
                              },
                              "children": [
                                {
                                  "textContent": "See ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc8446/#section-2.3",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 2.3",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#TLS13",
                                      },
                                      "children": [
                                        {
                                          "textContent": "TLS13",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " for a discussion of 0-RTT data and its
limitations.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.3-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-0-rtt-packet",
                              },
                              "children": [],
                              "nodeName": "span",
                              "type": "Element",
                            },
                            {
                              "attributes": {
                                "id": "figure-16",
                              },
                              "children": [
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "artwork art-text alignLeft",
                                    "id": "section-17.2.3-3.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "data-component": "HorizontalScrollable",
                                      },
                                      "children": [
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "textContent": "0-RTT Packet {
  Header Form (1) = 1,
  Fixed Bit (1) = 1,
  Long Packet Type (2) = 1,
  Reserved Bits (2),
  Packet Number Length (2),
  Version (32),
  Destination Connection ID Length (8),
  Destination Connection ID (0..160),
  Source Connection ID Length (8),
  Source Connection ID (0..160),
  Length (i),
  Packet Number (8..32),
  Packet Payload (8..),
}
",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "pre",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "div",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "selfRef",
                                        "href": "#figure-16",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Figure 16",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": ":
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "selfRef",
                                        "href": "#name-0-rtt-packet",
                                      },
                                      "children": [
                                        {
                                          "textContent": "0-RTT Packet",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "figcaption",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "figure",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.3-4",
                              },
                              "children": [
                                {
                                  "textContent": "Packet numbers for 0-RTT protected packets use the same space as 1-RTT protected
packets.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.3-4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.3-5",
                              },
                              "children": [
                                {
                                  "textContent": "After a client receives a Retry packet, 0-RTT packets are likely to have been
lost or discarded by the server.  A client ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " attempt to resend data in
0-RTT packets after it sends a new Initial packet.  New packet numbers ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be
used for any new packets that are sent; as described in ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#retry-continue",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2.5.3",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ",
reusing packet numbers could compromise packet protection.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.3-5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.3-6",
                              },
                              "children": [
                                {
                                  "textContent": "A client only receives acknowledgments for its 0-RTT packets once the handshake
is complete, as defined in ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc9001/#section-4.1.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 4.1.1",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#QUIC-TLS",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC-TLS",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.3-6",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.3-7",
                              },
                              "children": [
                                {
                                  "textContent": "A client ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST NOT",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " send 0-RTT packets once it starts processing 1-RTT packets
from the server.  This means that 0-RTT packets cannot contain any response to
frames from 1-RTT packets.  For instance, a client cannot send an ACK frame in a
0-RTT packet, because that can only acknowledge a 1-RTT packet.  An
acknowledgment for a 1-RTT packet ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be carried in a 1-RTT packet.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.3-7",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.3-8",
                              },
                              "children": [
                                {
                                  "textContent": "A server ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " treat a violation of remembered limits (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#zerortt-parameters",
                                  },
                                  "children": [
