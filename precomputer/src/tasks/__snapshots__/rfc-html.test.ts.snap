",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-20.1-2.9",
                          },
                          "children": [
                            {
                              "textContent": "STREAM",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_LIMIT",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_ERROR",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x04):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
