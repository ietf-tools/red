                    {
                      "attributes": {
                        "id": "section-22.3-1",
                      },
                      "children": [
                        {
                          "textContent": "IANA has added a registry for "QUIC Transport Parameters" under a "QUIC"
heading.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-22.3-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-22.3-2",
                      },
                      "children": [
                        {
                          "textContent": "The "QUIC Transport Parameters" registry governs a 62-bit space.  This registry
follows the registration policy from ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#iana-policy",
                          },
                          "children": [
                            {
                              "textContent": "Section 22.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".  Permanent registrations
in this registry are assigned using the Specification Required policy (",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "attributes": {
                                "class": "relref",
                                "href": "/info/rfc8126/#section-4.6",
                              },
                              "children": [
                                {
                                  "textContent": "Section 4.6",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": " of [",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#RFC8126",
                              },
                              "children": [
                                {
                                  "textContent": "RFC8126",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "), except for values between 0x00 and 0x3f (in hexadecimal),
inclusive, which are assigned using Standards Action or IESG Approval as defined
in Sections ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "relref",
                            "href": "/info/rfc8126/#section-4.9",
                          },
                          "children": [
