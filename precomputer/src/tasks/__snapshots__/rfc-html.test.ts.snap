                          },
                          "children": [
                            {
                              "textContent": "7.4. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-transport-parameters",
                          },
                          "children": [
                            {
                              "textContent": "Transport Parameters",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.4-1",
                      },
                      "children": [
                        {
                          "textContent": "During connection establishment, both endpoints make authenticated declarations
of their transport parameters.  Endpoints are required to comply with the
restrictions that each parameter defines; the description of each parameter
includes rules for its handling.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.4-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.4-2",
                      },
                      "children": [
                        {
                          "textContent": "Transport parameters are declarations that are made unilaterally by each
endpoint.  Each endpoint can choose values for transport parameters independent
of the values chosen by its peer.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.4-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.4-3",
                      },
                      "children": [
                        {
                          "textContent": "The encoding of the transport parameters is detailed in
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#transport-parameter-encoding",
                          },
                          "children": [
                            {
                              "textContent": "Section 18",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.4-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.4-4",
                      },
                      "children": [
                        {
                          "textContent": "QUIC includes the encoded transport parameters in the cryptographic handshake.
Once the handshake completes, the transport parameters declared by the peer are
available.  Each endpoint validates the values provided by its peer.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.4-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.4-5",
                      },
                      "children": [
                        {
                          "textContent": "Definitions for each of the defined transport parameters are included in
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#transport-parameter-definitions",
                          },
                          "children": [
                            {
                              "textContent": "Section 18.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.4-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.4-6",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " treat receipt of a transport parameter with an invalid value as
a connection error of type TRANSPORT",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
