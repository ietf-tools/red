                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": " shows an example of a connection with a 0-RTT handshake
and a single packet of 0-RTT data. Note that as described in
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-numbers",
                          },
                          "children": [
                            {
                              "textContent": "Section 12.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ", the server acknowledges 0-RTT data in 1-RTT packets, and
the client sends 1-RTT packets in the same packet number space.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.1-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-example-0-rtt-handshake",
                      },
                      "children": [],
                      "nodeName": "span",
                      "type": "Element",
                    },
                    {
                      "attributes": {
                        "id": "tls-0rtt-handshake",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "figure-6",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "artwork art-text alignLeft",
                                "id": "section-7.1-7.1",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "data-component": "HorizontalScrollable",
                                  },
                                  "children": [
                                    {
                                      "attributes": {},
                                      "children": [
                                        {
                                          "textContent": "Client                                                  Server

Initial[0]: CRYPTO[CH]
0-RTT[0]: STREAM[0, "..."] ->

                                 Initial[0]: CRYPTO[SH] ACK[0]
                                  Handshake[0] CRYPTO[EE, FIN]
                          <- 1-RTT[0]: STREAM[1, "..."] ACK[0]

Initial[1]: ACK[0]
Handshake[0]: CRYPTO[FIN], ACK[0]
1-RTT[1]: STREAM[0, "..."] ACK[0] ->

                                          Handshake[1]: ACK[0]
         <- 1-RTT[1]: HANDSHAKE_DONE, STREAM[3, "..."], ACK[1]
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "pre",
                                      "type": "Element",
                                    },
                                  ],
                                  "nodeName": "div",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [
                                {
                                  "attributes": {
                                    "class": "selfRef",
                                    "href": "#figure-6",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Figure 6",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ":
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "selfRef",
                                    "href": "#name-example-0-rtt-handshake",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Example 0-RTT Handshake",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "figcaption",
                              "type": "Element",
                            },
                          ],
                          "nodeName": "figure",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "negotiating-connection-ids",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-7.2",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-negotiating-connection-ids",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-7.2",
                          },
                          "children": [
                            {
                              "textContent": "7.2. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-negotiating-connection-ids",
                          },
                          "children": [
                            {
                              "textContent": "Negotiating Connection IDs",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.2-1",
                      },
                      "children": [
                        {
                          "textContent": "A connection ID is used to ensure consistent routing of packets, as described in
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#connection-id",
                          },
                          "children": [
                            {
                              "textContent": "Section 5.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".  The long header contains two connection IDs: the Destination
Connection ID is chosen by the recipient of the packet and is used to provide
consistent routing; the Source Connection ID is used to set the Destination
Connection ID used by the peer.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.2-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.2-2",
                      },
                      "children": [
                        {
                          "textContent": "During the handshake, packets with the long header (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#long-header",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ") are used
to establish the connection IDs used by both endpoints. Each endpoint uses the
Source Connection ID field to specify the connection ID that is used in the
Destination Connection ID field of packets being sent to them. After processing
the first Initial packet, each endpoint sets the Destination Connection ID
field in subsequent packets it sends to the value of the Source Connection ID
field that it received.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.2-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.2-3",
                      },
                      "children": [
                        {
                          "textContent": "When an Initial packet is sent by a client that has not previously received an
Initial or Retry packet from the server, the client populates the Destination
Connection ID field with an unpredictable value.  This Destination Connection ID
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be at least 8 bytes in length.  Until a packet is received from the server,
the client ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " use the same Destination Connection ID value on all packets in
this connection.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.2-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.2-4",
                      },
                      "children": [
                        {
                          "textContent": "The Destination Connection ID field from the first Initial packet sent by a
client is used to determine packet protection keys for Initial packets.  These
keys change after receiving a Retry packet; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "attributes": {
                                "class": "relref",
                                "href": "/info/rfc9001/#section-5.2",
                              },
                              "children": [
                                {
                                  "textContent": "Section 5.2",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": " of [",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#QUIC-TLS",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC-TLS",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.2-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.2-5",
                      },
                      "children": [
                        {
                          "textContent": "The client populates the Source Connection ID field with a value of its choosing
and sets the Source Connection ID Length field to indicate the length.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.2-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.2-6",
                      },
                      "children": [
                        {
                          "textContent": "0-RTT packets in the first flight use the same Destination Connection ID and
Source Connection ID values as the client's first Initial packet.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.2-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.2-7",
                      },
                      "children": [
                        {
                          "textContent": "Upon first receiving an Initial or Retry packet from the server, the client uses
the Source Connection ID supplied by the server as the Destination Connection ID
for subsequent packets, including any 0-RTT packets.  This means that a client
might have to change the connection ID it sets in the Destination Connection ID
field twice during connection establishment: once in response to a Retry packet
and once in response to an Initial packet from the server. Once a client has
received a valid Initial packet from the server, it ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " discard any subsequent
packet it receives on that connection with a different Source Connection ID.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.2-7",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.2-8",
                      },
                      "children": [
                        {
                          "textContent": "A client ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " change the Destination Connection ID it uses for sending packets
in response to only the first received Initial or Retry packet.  A server ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "
set the Destination Connection ID it uses for sending packets based on the first
received Initial packet. Any further changes to the Destination Connection ID
are only permitted if the values are taken from NEW",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_CONNECTION",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_ID",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " frames; if
subsequent Initial packets include a different Source Connection ID, they ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "
be discarded.  This avoids unpredictable outcomes that might otherwise result
from stateless processing of multiple Initial packets with different Source
Connection IDs.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.2-8",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.2-9",
                      },
                      "children": [
                        {
                          "textContent": "The Destination Connection ID that an endpoint sends can change over the
lifetime of a connection, especially in response to connection migration
(",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#migration",
                          },
                          "children": [
                            {
                              "textContent": "Section 9",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "); see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#issue-cid",
                          },
                          "children": [
                            {
                              "textContent": "Section 5.1.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": " for details.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.2-9",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "cid-auth",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-7.3",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-authenticating-connection-i",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-7.3",
                          },
                          "children": [
                            {
                              "textContent": "7.3. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-authenticating-connection-i",
                          },
                          "children": [
                            {
                              "textContent": "Authenticating Connection IDs",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.3-1",
                      },
                      "children": [
                        {
                          "textContent": "The choice each endpoint makes about connection IDs during the handshake is
authenticated by including all values in transport parameters; see
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#transport-parameters",
                          },
                          "children": [
                            {
                              "textContent": "Section 7.4",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ". This ensures that all connection IDs used for the
handshake are also authenticated by the cryptographic handshake.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.3-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.3-2",
                      },
                      "children": [
                        {
                          "textContent": "Each endpoint includes the value of the Source Connection ID field from the
first Initial packet it sent in the initial",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_source",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_connection",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_id",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " transport
parameter; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#transport-parameter-definitions",
                          },
                          "children": [
                            {
                              "textContent": "Section 18.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ". A server includes the
Destination Connection ID field from the first Initial packet it received from
the client in the original",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_destination",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_connection",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_id",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " transport parameter; if the
server sent a Retry packet, this refers to the first Initial packet received
before sending the Retry packet. If it sends a Retry packet, a server also
includes the Source Connection ID field from the Retry packet in the
retry",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_source",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_connection",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_id",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " transport parameter.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.3-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.3-3",
                      },
                      "children": [
                        {
                          "textContent": "The values provided by a peer for these transport parameters ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " match the
values that an endpoint used in the Destination and Source Connection ID fields
of Initial packets that it sent (and received, for servers). Endpoints ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "
validate that received transport parameters match received connection ID values.
Including connection ID values in transport parameters and verifying them
ensures that an attacker cannot influence the choice of connection ID for a
successful connection by injecting packets carrying attacker-chosen connection
IDs during the handshake.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-7.3-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-7.3-4",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " treat the absence of the initial",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
