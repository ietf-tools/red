                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "iana-random",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-22.1.2",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-selecting-codepoints",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-22.1.2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "22.1.2. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-selecting-codepoints",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Selecting Codepoints",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.2-1",
                              },
                              "children": [
                                {
                                  "textContent": "New requests for codepoints from QUIC registries ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " use a randomly selected
codepoint that excludes both existing allocations and the first unallocated
codepoint in the selected space.  Requests for multiple codepoints ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " use a
contiguous range.  This minimizes the risk that differing semantics are
attributed to the same codepoint by different implementations",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.2-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.2-2",
                              },
                              "children": [
                                {
                                  "textContent": "The use of the first unassigned codepoint is reserved for allocation using the
Standards Action policy; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc8126/#section-4.9",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 4.9",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#RFC8126",
                                      },
                                      "children": [
                                        {
                                          "textContent": "RFC8126",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  The early codepoint
assignment process ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "[",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#EARLY-ASSIGN",
                                      },
                                      "children": [
                                        {
                                          "textContent": "EARLY-ASSIGN",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " can be used for these values.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.2-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.2-3",
                              },
                              "children": [
                                {
                                  "textContent": "For codepoints that are encoded in variable-length integers
(",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#integer-encoding",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 16",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "), such as frame types, codepoints that encode to four or
eight bytes (that is, values 2",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "14",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "sup",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " and above) ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be used unless the
usage is especially sensitive to having a longer encoding.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.2-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.2-4",
                              },
                              "children": [
                                {
                                  "textContent": "Applications to register codepoints in QUIC registries ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " include a
requested codepoint
as part of the registration.  IANA ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " allocate the selected codepoint if the
codepoint is unassigned and the requirements of the registration policy are met.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.2-4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "reclaiming-provisional-codepoints",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-22.1.3",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-reclaiming-provisional-code",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-22.1.3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "22.1.3. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-reclaiming-provisional-code",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Reclaiming Provisional Codepoints",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.3-1",
                              },
                              "children": [
                                {
                                  "textContent": "A request might be made to remove an unused provisional registration from the
registry to reclaim space in a registry, or a portion of the registry (such as
the 64-16383 range for codepoints that use variable-length encodings).  This
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be done only for the codepoints with the earliest recorded date, and
entries that have been updated less than a year prior ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD NOT",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be reclaimed.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.3-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.3-2",
                              },
                              "children": [
                                {
                                  "textContent": "A request to remove a codepoint ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be reviewed by the designated experts.  The
experts ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " attempt to determine whether the codepoint is still in use.
Experts are advised to contact the listed contacts for the registration, plus as
wide a set of protocol implementers as possible in order to determine whether
any use of the codepoint is known.  The experts are also advised to allow at
least four weeks for responses.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.3-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.3-3",
                              },
                              "children": [
                                {
                                  "textContent": "If any use of the codepoints is identified by this search or a request to update
the registration is made, the codepoint ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST NOT",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be reclaimed.  Instead, the
date on the registration is updated.  A note might be added for the registration
recording relevant information that was learned.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.3-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.3-4",
                              },
                              "children": [
                                {
                                  "textContent": "If no use of the codepoint was identified and no request was made to update the
registration, the codepoint ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be removed from the registry.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.3-4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.3-5",
                              },
                              "children": [
                                {
                                  "textContent": "This review and consultation process also applies to requests to change a
provisional registration into a permanent registration, except that the goal is
not to determine whether there is no use of the codepoint but to determine that
the registration is an accurate representation of any deployed usage.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.3-5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "iana-permanent",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-22.1.4",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-permanent-registrations",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-22.1.4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "22.1.4. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-permanent-registrations",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Permanent Registrations",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.4-1",
                              },
                              "children": [
                                {
                                  "textContent": "Permanent registrations in QUIC registries use the Specification Required policy
(",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc8126/#section-4.6",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 4.6",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#RFC8126",
                                      },
                                      "children": [
                                        {
                                          "textContent": "RFC8126",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "), unless otherwise specified.  The designated expert
or experts verify that a specification exists and is readily accessible.
Experts are encouraged to be biased towards approving registrations unless they
are abusive, frivolous, or actively harmful (not merely aesthetically
displeasing or architecturally dubious).  The creation of a registry ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " specify
additional constraints on permanent registrations.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.4-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.4-2",
                              },
                              "children": [
                                {
                                  "textContent": "The creation of a registry ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " identify a range of codepoints where
registrations are governed by a different registration policy.  For instance,
the "QUIC Frame Types" registry (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#iana-frames",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 22.4",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") has a stricter policy for
codepoints in the range from 0 to 63.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.4-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.4-3",
                              },
                              "children": [
                                {
                                  "textContent": "Any stricter requirements for permanent registrations do not prevent provisional
registrations for affected codepoints.  For instance, a provisional registration
for a frame type of 61 could be requested.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.4-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.4-4",
                              },
                              "children": [
                                {
                                  "textContent": "All registrations made by Standards Track publications ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be permanent.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.4-4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.4-5",
                              },
                              "children": [
                                {
                                  "textContent": "All registrations in this document are assigned a permanent status and list a
change controller of the IETF and a contact of the QUIC Working Group
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "(quic",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "@ietf",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".org",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ").",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.4-5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "iana-version",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-22.2",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-quic-versions-registry",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-22.2",
                          },
                          "children": [
                            {
                              "textContent": "22.2. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-quic-versions-registry",
                          },
                          "children": [
                            {
                              "textContent": "QUIC Versions Registry",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-22.2-1",
                      },
                      "children": [
                        {
                          "textContent": "IANA has added a registry for "QUIC Versions" under a "QUIC" heading.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-22.2-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-22.2-2",
                      },
                      "children": [
                        {
                          "textContent": "The "QUIC Versions" registry governs a 32-bit space; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#versions",
                          },
                          "children": [
                            {
                              "textContent": "Section 15",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ". This
registry follows the registration policy from ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#iana-policy",
                          },
                          "children": [
                            {
                              "textContent": "Section 22.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ". Permanent
registrations in this registry are assigned using the Specification Required
policy (",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "attributes": {
                                "class": "relref",
                                "href": "/info/rfc8126/#section-4.6",
                              },
                              "children": [
                                {
                                  "textContent": "Section 4.6",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": " of [",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#RFC8126",
                              },
                              "children": [
                                {
                                  "textContent": "RFC8126",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": ").",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-22.2-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-22.2-3",
                      },
                      "children": [
                        {
                          "textContent": "The codepoint of 0x00000001 for the protocol is assigned with permanent status
to the protocol defined in this document. The codepoint of 0x00000000 is
permanently reserved; the note for this codepoint indicates that this version is
reserved for version negotiation.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-22.2-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-22.2-4",
                      },
                      "children": [
                        {
                          "textContent": "All codepoints that follow the pattern 0x?a?a?a?a are reserved, ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be
assigned by IANA, and ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " appear in the listing of assigned values.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-22.2-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
