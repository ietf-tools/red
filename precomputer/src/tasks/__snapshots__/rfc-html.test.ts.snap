                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
            ",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "figcaption",
                                      "type": "Element",
                                    },
                                  ],
                                  "nodeName": "figure",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.5-3",
                              },
                              "children": [
                                {
                                  "textContent": "A Retry packet does not contain any protected
fields.  The value in the Unused field is set to an arbitrary value by the
server; a client ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " ignore these bits.  In addition to the fields from the
long header, it contains these additional fields:",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.5-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "break",
                              },
                              "children": [],
                              "nodeName": "span",
                              "type": "Element",
                            },
                            {
                              "attributes": {
                                "class": "dlParallel",
                                "id": "section-17.2.5-4",
                              },
                              "children": [
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.5-4.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Retry Token:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.5-4.2",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5-4.2.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "An opaque token that the server can use to validate the client's address.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5-4.2.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.5-4.3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Retry Integrity Tag:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.5-4.4",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5-4.4.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Defined in Section ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "attributes": {
                                                "class": "relref",
                                                "href": "/info/rfc9001/#section-5.8",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "5.8",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": " (",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "relref",
                                                "href": "/info/rfc9001/#section-5.8",
                                              },
                                              "children": [
                                                {
                                                  "textContent": ""Retry Packet Integrity"",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": ")",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " of ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "textContent": "[",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#QUIC-TLS",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "QUIC-TLS",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5-4.4.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "dl",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "sending-a-retry-packet",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.5.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "name-sending-a-retry-packet",
                                      },
                                      "children": [
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-number selfRef",
                                            "href": "#section-17.2.5.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "17.2.5.1. ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-name selfRef",
                                            "href": "#name-sending-a-retry-packet",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Sending a Retry Packet",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
            ",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "h5",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.1-1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The server populates the Destination Connection ID with the connection ID that
the client included in the Source Connection ID of the Initial packet.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.1-1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.1-2",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The server includes a connection ID of its choice in the Source Connection ID
field.  This value ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST NOT",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " be equal to the Destination Connection ID field of
the packet sent by the client.  A client ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " discard a Retry packet that
contains a Source Connection ID field that is identical to the Destination
Connection ID field of its Initial packet.  The client ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " use the value from
the Source Connection ID field of the Retry packet in the Destination Connection
ID field of subsequent packets that it sends.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.1-2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.1-3",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A server ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MAY",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " send Retry packets in response to Initial and 0-RTT packets.  A
server can either discard or buffer 0-RTT packets that it receives.  A server
can send multiple Retry packets as it receives Initial or 0-RTT packets.  A
server ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST NOT",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " send more than one Retry packet in response to a single UDP
datagram.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.1-3",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "section",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "handling-a-retry-packet",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.5.2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "name-handling-a-retry-packet",
                                      },
                                      "children": [
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-number selfRef",
                                            "href": "#section-17.2.5.2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "17.2.5.2. ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-name selfRef",
                                            "href": "#name-handling-a-retry-packet",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Handling a Retry Packet",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
            ",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "h5",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.2-1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A client ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " accept and process at most one Retry packet for each connection
attempt.  After the client has received and processed an Initial or Retry packet
from the server, it ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " discard any subsequent Retry packets that it receives.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.2-1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.2-2",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Clients ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " discard Retry packets that have a Retry Integrity Tag that cannot
be validated; see ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "attributes": {
                                                "class": "relref",
                                                "href": "/info/rfc9001/#section-5.8",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Section 5.8",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": " of [",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#QUIC-TLS",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "QUIC-TLS",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ". This diminishes an attacker's
ability to inject a Retry packet and protects against accidental corruption of
Retry packets.  A client ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " discard a Retry packet with a zero-length Retry
Token field.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.2-2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.2-3",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The client responds to a Retry packet with an Initial packet that includes the
provided Retry token to continue connection establishment.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.2-3",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.2-4",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A client sets the Destination Connection ID field of this Initial packet to the
value from the Source Connection ID field in the Retry packet. Changing the
Destination Connection ID field also results in a change to the keys used to
protect the Initial packet. It also sets the Token field to the token provided
in the Retry packet. The client ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST NOT",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " change the Source Connection ID because
the server could include the connection ID as part of its token validation
logic; see ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#token-integrity",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 8.1.4",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.2-4",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.2-5",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A Retry packet does not include a packet number and cannot be explicitly
acknowledged by a client.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.2-5",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "section",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "retry-continue",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.2.5.3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "name-continuing-a-handshake-afte",
                                      },
                                      "children": [
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-number selfRef",
                                            "href": "#section-17.2.5.3",
                                          },
                                          "children": [
                                            {
                                              "textContent": "17.2.5.3. ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-name selfRef",
                                            "href": "#name-continuing-a-handshake-afte",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Continuing a Handshake after Retry",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
            ",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "h5",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.3-1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Subsequent Initial packets from the client include the connection ID and token
values from the Retry packet. The client copies the Source Connection ID field
from the Retry packet to the Destination Connection ID field and uses this
value until an Initial packet with an updated value is received; see
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#negotiating-connection-ids",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 7.2",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ". The value of the Token field is copied to all
subsequent Initial packets; see ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#validate-retry",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 8.1.2",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.3-1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.3-2",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Other than updating the Destination Connection ID and Token fields, the Initial
packet sent by the client is subject to the same restrictions as the first
Initial packet.  A client ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " use the same cryptographic handshake message it
included in this packet.  A server ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MAY",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " treat a packet that contains a different
cryptographic handshake message as a connection error or discard it.  Note that
including a Token field reduces the available space for the cryptographic
handshake message, which might result in the client needing to send multiple
Initial packets.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.3-2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.3-3",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A client ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MAY",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " attempt 0-RTT after receiving a Retry packet by sending 0-RTT
packets to the connection ID provided by the server.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.3-3",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.3-4",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A client ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST NOT",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " reset the packet number for any packet number space after
processing a Retry packet. In particular, 0-RTT packets contain confidential
information that will most likely be retransmitted on receiving a Retry packet.
The keys used to protect these new 0-RTT packets will not change as a result of
responding to a Retry packet. However, the data sent in these packets could be
different than what was sent earlier. Sending these new packets with the same
packet number is likely to compromise the packet protection for those packets
because the same key and nonce could be used to protect different content.
A server ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MAY",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " abort the connection if it detects that the client reset the
packet number.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.3-4",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.2.5.3-5",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The connection IDs used in Initial and Retry packets exchanged between client
and server are copied to the transport parameters and validated as described
in ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#cid-auth",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 7.3",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.2.5.3-5",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "section",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "short-header",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-17.3",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-short-header-packets",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-17.3",
                          },
                          "children": [
                            {
                              "textContent": "17.3. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-short-header-packets",
                          },
                          "children": [
                            {
                              "textContent": "Short Header Packets",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.3-1",
                      },
                      "children": [
                        {
                          "textContent": "This version of QUIC defines a single packet type that uses the short packet
header.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.3-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "packet-1rtt",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-17.3.1",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-1-rtt-packet",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-17.3.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "17.3.1. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-1-rtt-packet",
                                  },
                                  "children": [
                                    {
                                      "textContent": "1-RTT Packet",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.3.1-1",
                              },
                              "children": [
                                {
                                  "textContent": "A 1-RTT packet uses a short packet header. It is used after the version and
1-RTT keys are negotiated.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.3.1-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-1-rtt-packet-2",
                              },
                              "children": [],
                              "nodeName": "span",
                              "type": "Element",
                            },
                            {
                              "attributes": {
                                "id": "figure-19",
                              },
                              "children": [
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "artwork art-text alignLeft",
                                    "id": "section-17.3.1-2.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "data-component": "HorizontalScrollable",
                                      },
                                      "children": [
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "textContent": "1-RTT Packet {
  Header Form (1) = 0,
  Fixed Bit (1) = 1,
  Spin Bit (1),
  Reserved Bits (2),
  Key Phase (1),
  Packet Number Length (2),
  Destination Connection ID (0..160),
  Packet Number (8..32),
  Packet Payload (8..),
}
",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "pre",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "div",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "selfRef",
                                        "href": "#figure-19",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Figure 19",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": ":
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "selfRef",
                                        "href": "#name-1-rtt-packet-2",
                                      },
                                      "children": [
                                        {
                                          "textContent": "1-RTT Packet",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "figcaption",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "figure",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.3.1-3",
                              },
                              "children": [
                                {
                                  "textContent": "1-RTT packets contain the following fields:",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.3.1-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "break",
                              },
                              "children": [],
                              "nodeName": "span",
                              "type": "Element",
                            },
                            {
                              "attributes": {
                                "class": "dlParallel",
                                "id": "section-17.3.1-4",
                              },
                              "children": [
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Header Form:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.2",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.3.1-4.2.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The most significant bit (0x80) of byte 0 is set to 0 for the short header.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.3.1-4.2.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Fixed Bit:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.4",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.3.1-4.4.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The next bit (0x40) of byte 0 is set to 1.  Packets containing a zero value
for this bit are not valid packets in this version and ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " be discarded.  A
value of 1 for this bit allows QUIC to coexist with other protocols; see
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "textContent": "[",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#RFC7983",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "RFC7983",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.3.1-4.4.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
