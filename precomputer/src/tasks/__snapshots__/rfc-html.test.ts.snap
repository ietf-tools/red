                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {},
                      "children": [
                        {
                          "attributes": {
                            "class": "selfRef",
                            "href": "#figure-20",
                          },
                          "children": [
                            {
                              "textContent": "Figure 20",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ":
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "selfRef",
                            "href": "#name-sequence-of-transport-param",
                          },
                          "children": [
                            {
                              "textContent": "Sequence of Transport Parameters",
                              "type": "Text",
                            },
