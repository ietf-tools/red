                              "attributes": {
                                "id": "section-1.2-3.18.1",
                              },
                              "children": [
                                {
                                  "textContent": "An identifier that is used to identify a QUIC connection at an endpoint.
Each endpoint selects one or more connection IDs for its peer to include in
packets sent towards the endpoint.  This value is opaque to the peer.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
