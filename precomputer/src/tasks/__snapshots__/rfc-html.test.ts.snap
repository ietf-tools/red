                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "  An endpoint that receives a
STOP_SENDING frame for a receive-only stream ",
                          "type": "Text",
                        },
