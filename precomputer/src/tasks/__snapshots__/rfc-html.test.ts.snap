                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-19.3.1-4",
                              },
                              "children": [
                                {
                                  "textContent": "The fields that form each ACK Range are:",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.3.1-4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "break",
                              },
                              "children": [],
                              "nodeName": "span",
                              "type": "Element",
                            },
                            {
                              "attributes": {
                                "class": "dlParallel",
                                "id": "section-19.3.1-5",
                              },
                              "children": [
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-19.3.1-5.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Gap:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-19.3.1-5.2",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-19.3.1-5.2.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A variable-length integer indicating the number of contiguous unacknowledged
packets preceding the packet number one lower than the smallest in the
preceding ACK Range.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-19.3.1-5.2.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-19.3.1-5.3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "ACK Range Length:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-19.3.1-5.4",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-19.3.1-5.4.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A variable-length integer indicating the number of contiguous acknowledged
packets preceding the largest packet number, as determined by the
preceding Gap.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-19.3.1-5.4.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "dl",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-19.3.1-6",
                              },
                              "children": [
                                {
                                  "textContent": "Gap and ACK Range Length values use a relative integer encoding for efficiency.
Though each encoded value is positive, the values are subtracted, so that each
ACK Range describes progressively lower-numbered packets.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.3.1-6",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-19.3.1-7",
                              },
                              "children": [
                                {
                                  "textContent": "Each ACK Range acknowledges a contiguous range of packets by indicating the
number of acknowledged packets that precede the largest packet number in that
range.  A value of 0 indicates that only the largest packet number is
acknowledged.  Larger ACK Range values indicate a larger range, with
corresponding lower values for the smallest packet number in the range.  Thus,
given a largest packet number for the range, the smallest value is determined by
the following formula:",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.3.1-7",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "artwork art-text alignLeft",
                                "id": "section-19.3.1-8",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "data-component": "HorizontalScrollable",
                                  },
                                  "children": [
                                    {
                                      "attributes": {},
                                      "children": [
                                        {
                                          "textContent": "   smallest = largest - ack_range
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "pre",
                                      "type": "Element",
                                    },
                                  ],
                                  "nodeName": "div",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.3.1-8",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-19.3.1-9",
                              },
                              "children": [
                                {
                                  "textContent": "An ACK Range acknowledges all packets between the smallest packet number and the
largest, inclusive.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.3.1-9",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-19.3.1-10",
                              },
                              "children": [
                                {
                                  "textContent": "The largest value for an ACK Range is determined by cumulatively subtracting the
size of all preceding ACK Range Lengths and Gaps.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.3.1-10",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-19.3.1-11",
                              },
                              "children": [
                                {
                                  "textContent": "Each Gap indicates a range of packets that are not being acknowledged.  The
number of packets in the gap is one higher than the encoded value of the Gap
field.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.3.1-11",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-19.3.1-12",
                              },
                              "children": [
                                {
                                  "textContent": "The value of the Gap field establishes the largest packet number value for the
subsequent ACK Range using the following formula:",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.3.1-12",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "artwork art-text alignLeft",
                                "id": "section-19.3.1-13",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "data-component": "HorizontalScrollable",
                                  },
                                  "children": [
                                    {
                                      "attributes": {},
                                      "children": [
                                        {
                                          "textContent": "   largest = previous_smallest - gap - 2
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "pre",
                                      "type": "Element",
                                    },
                                  ],
                                  "nodeName": "div",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.3.1-13",
