                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-1.3-4.13",
                          },
                          "children": [
                            {
                              "textContent": "x (L) ...:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-1.3-4.14",
                            "style": "margin-left:1.5em",
