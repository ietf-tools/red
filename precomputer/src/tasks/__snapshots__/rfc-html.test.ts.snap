                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "), data in CRYPTO frames for
Handshake packets is discarded -- and no longer retransmitted -- when Handshake
protection keys are discarded.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.4-7",
