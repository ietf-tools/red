                    {
                      "attributes": {
                        "id": "section-a.2-6",
                      },
                      "children": [
                        {
                          "textContent": "In the same state, sending a packet with a number of 0xace8fe uses the 24-bit
encoding, because at least 18 bits are required to represent twice the range
(131,222 packets, or 0x020096).",
                          "type": "Text",
                        },
