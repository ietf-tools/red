            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "normal",
                                        "id": "section-7.4.1-7.2",
                                      },
                                      "children": [
                                        {
                                          "textContent": "initial_max_data",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-7.4.1-7.2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "li",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
