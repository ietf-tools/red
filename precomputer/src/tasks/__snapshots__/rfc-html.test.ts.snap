                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.4-1",
                              },
                              "children": [
                                {
                                  "textContent": "A Handshake packet uses long headers with a type value of 0x02, followed by the
Length and Packet Number fields; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#long-header",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  The first byte contains
the Reserved and Packet Number Length bits; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#long-header",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  It is used
to carry cryptographic handshake messages and acknowledgments from the server
and client.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.2.4-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-handshake-protected-packet",
                              },
                              "children": [],
                              "nodeName": "span",
                              "type": "Element",
                            },
                            {
                              "attributes": {
                                "id": "handshake-format",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "figure-17",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "artwork art-text alignLeft",
                                        "id": "section-17.2.4-2.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "data-component": "HorizontalScrollable",
                                          },
                                          "children": [
                                            {
                                              "attributes": {},
                                              "children": [
                                                {
                                                  "textContent": "Handshake Packet {
  Header Form (1) = 1,
  Fixed Bit (1) = 1,
  Long Packet Type (2) = 2,
  Reserved Bits (2),
  Packet Number Length (2),
  Version (32),
  Destination Connection ID Length (8),
  Destination Connection ID (0..160),
  Source Connection ID Length (8),
  Source Connection ID (0..160),
  Length (i),
  Packet Number (8..32),
  Packet Payload (8..),
}
",
                                                  "type": "Text",
                                                },
                                              ],
