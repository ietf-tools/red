                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.2.4-7",
                              },
                              "children": [
                                {
                                  "textContent": "Like Initial packets (see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#discard-initial",
                                  },
                                  "children": [
