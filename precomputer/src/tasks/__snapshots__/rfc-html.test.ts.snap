                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-3.4-4",
                      },
                      "children": [
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-3.4-4.1",
                          },
                          "children": [
                            {
                              "textContent": "Note (*1): A stream is considered "idle" if it has not yet been created or if
the receiving part of the stream is in the "Recv" state without yet having
received any frames.",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "pilcrow",
                                "href": "#section-3.4-4.1",
                              },
                              "children": [
                                {
                                  "textContent": "¶",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                          ],
                          "nodeName": "p",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "aside",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "solicited-state-transitions",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-3.5",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-solicited-state-transitions",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-3.5",
                          },
                          "children": [
                            {
                              "textContent": "3.5. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-solicited-state-transitions",
                          },
                          "children": [
                            {
                              "textContent": "Solicited State Transitions",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-3.5-1",
                      },
                      "children": [
                        {
                          "textContent": "If an application is no longer interested in the data it is receiving on a
stream, it can abort reading the stream and specify an application error code.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-3.5-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-3.5-2",
                      },
                      "children": [
                        {
                          "textContent": "If the stream is in the "Recv" or "Size Known" state, the transport ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "
signal this by sending a STOP_SENDING frame to prompt closure of the stream in
the opposite direction.  This typically indicates that the receiving application
is no longer reading data it receives from the stream, but it is not a guarantee
that incoming data will be ignored.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-3.5-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-3.5-3",
                      },
                      "children": [
                        {
                          "textContent": "STREAM frames received after sending a STOP_SENDING frame are still counted
toward connection and stream flow control, even though these frames can be
discarded upon receipt.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-3.5-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-3.5-4",
                      },
                      "children": [
                        {
                          "textContent": "A STOP_SENDING frame requests that the receiving endpoint send a RESET_STREAM
frame.  An endpoint that receives a STOP_SENDING frame ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " send a RESET_STREAM
frame if the stream is in the "Ready" or "Send" state.  If the stream is in the
"Data Sent" state, the endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MAY",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " defer sending the RESET_STREAM frame until
the packets containing outstanding data are acknowledged or declared lost.  If
any outstanding data is declared lost, the endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " send a RESET_STREAM
frame instead of retransmitting the data.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-3.5-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-3.5-5",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " copy the error code from the STOP_SENDING frame to the
RESET_STREAM frame it sends, but it can use any application error code.  An
endpoint that sends a STOP_SENDING frame ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MAY",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " ignore the error code in any
RESET_STREAM frames subsequently received for that stream.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-3.5-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-3.5-6",
                      },
                      "children": [
                        {
                          "textContent": "STOP_SENDING ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " only be sent for a stream that has not been reset by the
peer. STOP_SENDING is most useful for streams in the "Recv" or "Size Known"
state.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-3.5-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-3.5-7",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint is expected to send another STOP_SENDING frame if a packet
containing a previous STOP_SENDING is lost.  However, once either all stream
data or a RESET_STREAM frame has been received for the stream -- that is, the
stream is in any state other than "Recv" or "Size Known" -- sending a
STOP_SENDING frame is unnecessary.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-3.5-7",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-3.5-8",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint that wishes to terminate both directions of a bidirectional stream
can terminate one direction by sending a RESET_STREAM frame, and it can
encourage prompt termination in the opposite direction by sending a STOP_SENDING
frame.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-3.5-8",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
          ],
          "nodeName": "section",
          "type": "Element",
        },
        {
          "textContent": "
",
          "type": "Text",
        },
      ],
      "nodeName": "div",
      "type": "Element",
    },
    {
      "textContent": "
",
      "type": "Text",
    },
    {
      "attributes": {
        "id": "flow-control",
      },
      "children": [
        {
          "textContent": "
",
          "type": "Text",
        },
        {
          "attributes": {
            "id": "section-4",
          },
          "children": [
            {
              "textContent": "
      ",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "name-flow-control",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "section-number selfRef",
                    "href": "#section-4",
                  },
                  "children": [
                    {
                      "textContent": "4. ",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "attributes": {
                    "class": "section-name selfRef",
                    "href": "#name-flow-control",
                  },
                  "children": [
                    {
                      "textContent": "Flow Control",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": "
      ",
                  "type": "Text",
                },
              ],
              "nodeName": "h2",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-4-1",
              },
              "children": [
                {
                  "textContent": "Receivers need to limit the amount of data that they are required to buffer, in
order to prevent a fast sender from overwhelming them or a malicious sender from
consuming a large amount of memory.  To enable a receiver to limit memory
commitments for a connection, streams are flow controlled both individually and
across a connection as a whole.  A QUIC receiver controls the maximum amount of
data the sender can send on a stream as well as across all streams at any time,
as described in Sections ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#data-flow-control",
                  },
                  "children": [
                    {
                      "textContent": "4.1",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": " and ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#fc-credit",
                  },
                  "children": [
                    {
                      "textContent": "4.2",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ".",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-4-1",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-4-2",
              },
              "children": [
                {
                  "textContent": "Similarly, to limit concurrency within a connection, a QUIC endpoint controls
the maximum cumulative number of streams that its peer can initiate, as
described in ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#controlling-concurrency",
                  },
                  "children": [
                    {
                      "textContent": "Section 4.6",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ".",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-4-2",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-4-3",
              },
              "children": [
                {
                  "textContent": "Data sent in CRYPTO frames is not flow controlled in the same way as stream
data.  QUIC relies on the cryptographic protocol implementation to avoid
excessive buffering of data; see ",
                  "type": "Text",
                },
                {
                  "attributes": {},
                  "children": [
                    {
                      "textContent": "[",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "class": "xref",
                        "href": "#QUIC-TLS",
                      },
                      "children": [
                        {
                          "textContent": "QUIC-TLS",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "a",
                      "type": "Element",
                    },
                    {
                      "textContent": "]",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "span",
                  "type": "Element",
                },
                {
                  "textContent": ". To avoid excessive buffering at
multiple layers, QUIC implementations ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "bcp14",
                  },
                  "children": [
                    {
                      "textContent": "SHOULD",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "span",
                  "type": "Element",
                },
                {
                  "textContent": " provide an interface for the
cryptographic protocol implementation to communicate its buffering limits.",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-4-3",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "data-flow-control",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-4.1",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-data-flow-control",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-4.1",
                          },
                          "children": [
                            {
                              "textContent": "4.1. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-data-flow-control",
                          },
                          "children": [
                            {
                              "textContent": "Data Flow Control",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.1-1",
                      },
                      "children": [
                        {
                          "textContent": "QUIC employs a limit-based flow control scheme where a receiver advertises the
limit of total bytes it is prepared to receive on a given stream or for the
entire connection.  This leads to two levels of data flow control in QUIC:",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.1-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "data-component": "HorizontalScrollable",
                      },
                      "children": [
                        {
                          "attributes": {
                            "class": "normal",
                          },
                          "children": [
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "normal",
                                "id": "section-4.1-2.1",
                              },
                              "children": [
                                {
                                  "textContent": "Stream flow control, which prevents a single stream from consuming the entire
receive buffer for a connection by limiting the amount of data that can be
sent on each stream.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-4.1-2.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "li",
                              "type": "Element",
                            },
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "normal",
                                "id": "section-4.1-2.2",
                              },
                              "children": [
                                {
                                  "textContent": "Connection flow control, which prevents senders from exceeding a receiver's
buffer capacity for the connection by limiting the total bytes of stream data
sent in STREAM frames on all streams.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-4.1-2.2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "li",
                              "type": "Element",
                            },
                            {
                              "textContent": "
        ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "ul",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.1-3",
                      },
                      "children": [
                        {
                          "textContent": "Senders ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " send data in excess of either limit.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.1-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.1-4",
                      },
                      "children": [
                        {
                          "textContent": "A receiver sets initial limits for all streams through transport parameters
during the handshake (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#transport-parameters",
                          },
                          "children": [
                            {
                              "textContent": "Section 7.4",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ").  Subsequently, a receiver sends
MAX_STREAM_DATA frames (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#frame-max-stream-data",
                          },
                          "children": [
                            {
                              "textContent": "Section 19.10",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ") or MAX_DATA frames
(",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#frame-max-data",
                          },
                          "children": [
                            {
                              "textContent": "Section 19.9",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ") to the sender to advertise larger limits.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.1-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.1-5",
                      },
                      "children": [
                        {
                          "textContent": "A receiver can advertise a larger limit for a stream by sending a
MAX_STREAM_DATA frame with the corresponding stream ID. A MAX_STREAM_DATA frame
indicates the maximum absolute byte offset of a stream. A receiver could
determine the flow control offset to be advertised based on the current offset
of data consumed on that stream.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.1-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.1-6",
                      },
                      "children": [
                        {
                          "textContent": "A receiver can advertise a larger limit for a connection by sending a MAX_DATA
frame, which indicates the maximum of the sum of the absolute byte offsets of
all streams.  A receiver maintains a cumulative sum of bytes received on all
streams, which is used to check for violations of the advertised connection or
stream data limits. A receiver could determine the maximum data limit to be
advertised based on the sum of bytes consumed on all streams.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.1-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.1-7",
                      },
                      "children": [
                        {
                          "textContent": "Once a receiver advertises a limit for the connection or a stream, it is not an
error to advertise a smaller limit, but the smaller limit has no effect.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.1-7",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.1-8",
                      },
                      "children": [
                        {
                          "textContent": "A receiver ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " close the connection with an error of type FLOW",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_CONTROL",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_ERROR",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " if
the sender violates the advertised connection or stream data limits; see
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#error-handling",
                          },
                          "children": [
                            {
                              "textContent": "Section 11",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": " for details on error handling.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.1-8",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.1-9",
                      },
                      "children": [
                        {
                          "textContent": "A sender ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " ignore any MAX_STREAM_DATA or MAX_DATA frames that do not increase
flow control limits.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.1-9",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.1-10",
                      },
                      "children": [
                        {
                          "textContent": "If a sender has sent data up to the limit, it will be unable to send new data
and is considered blocked.  A sender ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " send a STREAM",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_DATA",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_BLOCKED",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " or
DATA_BLOCKED frame to indicate to the receiver that it has data to write but is
blocked by flow control limits.  If a sender is blocked for a period longer than
the idle timeout (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#idle-timeout",
                          },
                          "children": [
                            {
                              "textContent": "Section 10.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "), the receiver might close the connection
even when the sender has data that is available for transmission.  To keep the
connection from closing, a sender that is flow control limited ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "
periodically send a STREAM",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_DATA",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_BLOCKED",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " or DATA_BLOCKED frame when it has no
ack-eliciting packets in flight.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.1-10",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "fc-credit",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-4.2",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-increasing-flow-control-lim",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-4.2",
                          },
                          "children": [
                            {
                              "textContent": "4.2. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-increasing-flow-control-lim",
                          },
                          "children": [
                            {
                              "textContent": "Increasing Flow Control Limits",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.2-1",
                      },
                      "children": [
                        {
                          "textContent": "Implementations decide when and how much credit to advertise in MAX_STREAM_DATA
and MAX_DATA frames, but this section offers a few considerations.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.2-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.2-2",
                      },
                      "children": [
                        {
                          "textContent": "To avoid blocking a sender, a receiver ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MAY",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " send a MAX_STREAM_DATA or MAX_DATA
frame multiple times within a round trip or send it early enough to allow time
for loss of the frame and subsequent recovery.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.2-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.2-3",
                      },
                      "children": [
                        {
                          "textContent": "Control frames contribute to connection overhead. Therefore, frequently sending
MAX_STREAM_DATA and MAX_DATA frames with small changes is undesirable.  On the
other hand, if updates are less frequent, larger increments to limits are
necessary to avoid blocking a sender, requiring larger resource commitments at
the receiver.  There is a trade-off between resource commitment and overhead
when determining how large a limit is advertised.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.2-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.2-4",
                      },
                      "children": [
                        {
                          "textContent": "A receiver can use an autotuning mechanism to tune the frequency and amount of
advertised additional credit based on a round-trip time estimate and the rate at
which the receiving application consumes data, similar to common TCP
implementations",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "  As an optimization, an endpoint could send frames related to
flow control only when there are other frames to send, ensuring that flow
control does not cause extra packets to be sent.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.2-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.2-5",
                      },
                      "children": [
                        {
                          "textContent": "A blocked sender is not required to send STREAM",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_DATA",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_BLOCKED",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " or DATA_BLOCKED
frames. Therefore, a receiver ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " wait for a STREAM",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_DATA",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_BLOCKED",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " or
DATA_BLOCKED frame before sending a MAX_STREAM_DATA or MAX_DATA frame; doing so
could result in the sender being blocked for the rest of the connection. Even if
the sender sends these frames, waiting for them will result in the sender being
blocked for at least an entire round trip.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.2-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.2-6",
                      },
                      "children": [
                        {
                          "textContent": "When a sender receives credit after being blocked, it might be able to send a
large amount of data in response, resulting in short-term congestion; see
",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "attributes": {
                                "class": "relref",
                                "href": "/info/rfc9002/#section-7.7",
                              },
                              "children": [
                                {
                                  "textContent": "Section 7.7",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": " of [",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#QUIC-RECOVERY",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC-RECOVERY",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " for a discussion of how a sender can avoid this
congestion.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.2-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "flow-control-performance",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-4.3",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-flow-control-performance",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-4.3",
                          },
                          "children": [
                            {
                              "textContent": "4.3. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-flow-control-performance",
                          },
                          "children": [
                            {
                              "textContent": "Flow Control Performance",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.3-1",
                      },
                      "children": [
                        {
                          "textContent": "If an endpoint cannot ensure that its peer always has available flow control
credit that is greater than the peer's bandwidth-delay product on this
connection, its receive throughput will be limited by flow control.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.3-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.3-2",
                      },
                      "children": [
                        {
                          "textContent": "Packet loss can cause gaps in the receive buffer, preventing the application
from consuming data and freeing up receive buffer space.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.3-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.3-3",
                      },
                      "children": [
                        {
                          "textContent": "Sending timely updates of flow control limits can improve performance.
Sending packets only to provide flow control updates can increase network
load and adversely affect performance. Sending flow control updates along with
other frames, such as ACK frames, reduces the cost of those updates.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.3-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "stream-cancellation",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-4.4",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-handling-stream-cancellatio",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-4.4",
                          },
                          "children": [
                            {
                              "textContent": "4.4. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-handling-stream-cancellatio",
                          },
                          "children": [
                            {
                              "textContent": "Handling Stream Cancellation",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.4-1",
                      },
                      "children": [
                        {
                          "textContent": "Endpoints need to eventually agree on the amount of flow control credit that has
been consumed on every stream, to be able to account for all bytes for
connection",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "-level",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " flow control.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.4-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.4-2",
                      },
                      "children": [
                        {
                          "textContent": "On receipt of a RESET_STREAM frame, an endpoint will tear down state for the
matching stream and ignore further data arriving on that stream.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.4-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.4-3",
                      },
                      "children": [
                        {
                          "textContent": "RESET_STREAM terminates one direction of a stream abruptly.  For a bidirectional
stream, RESET_STREAM has no effect on data flow in the opposite direction.  Both
endpoints ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " maintain flow control state for the stream in the unterminated
direction until that direction enters a terminal state.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.4-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "final-size",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-4.5",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-stream-final-size",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-4.5",
                          },
                          "children": [
                            {
                              "textContent": "4.5. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-stream-final-size",
                          },
                          "children": [
                            {
                              "textContent": "Stream Final Size",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.5-1",
                      },
                      "children": [
                        {
                          "textContent": "The final size is the amount of flow control credit that is consumed by a
stream.  Assuming that every contiguous byte on the stream was sent once, the
final size is the number of bytes sent.  More generally, this is one higher
than the offset of the byte with the largest offset sent on the stream, or zero
if no bytes were sent.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.5-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.5-2",
                      },
                      "children": [
                        {
                          "textContent": "A sender always communicates the final size of a stream to the receiver
reliably, no matter how the stream is terminated. The final size is the sum of
the Offset and Length fields of a STREAM frame with a FIN flag, noting that
these fields might be implicit.  Alternatively, the Final Size field of a
RESET_STREAM frame carries this value. This guarantees that both endpoints agree
on how much flow control credit was consumed by the sender on that stream.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.5-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.5-3",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint will know the final size for a stream when the receiving part of the
stream enters the "Size Known" or "Reset Recvd" state (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#stream-states",
                          },
                          "children": [
                            {
                              "textContent": "Section 3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ").  The
receiver ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " use the final size of the stream to account for all bytes sent on
the stream in its connection",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "-level",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " flow controller.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.5-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.5-4",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " send data on a stream at or beyond the final size.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.5-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.5-5",
                      },
                      "children": [
                        {
                          "textContent": "Once a final size for a stream is known, it cannot change.  If a RESET_STREAM or
STREAM frame is received indicating a change in the final size for the stream,
an endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " respond with an error of type FINAL",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_SIZE",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_ERROR;",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " see
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#error-handling",
                          },
                          "children": [
                            {
                              "textContent": "Section 11",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": " for details on error handling.  A receiver ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " treat
receipt of data at or beyond the final size as an error of type
FINAL",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_SIZE",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_ERROR,",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " even after a stream is closed.  Generating these errors is not
mandatory, because requiring that an endpoint generate these errors also means
that the endpoint needs to maintain the final size state for closed streams,
which could mean a significant state commitment.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.5-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "controlling-concurrency",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-4.6",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-controlling-concurrency",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-4.6",
                          },
                          "children": [
                            {
                              "textContent": "4.6. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-controlling-concurrency",
                          },
                          "children": [
                            {
                              "textContent": "Controlling Concurrency",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.6-1",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint limits the cumulative number of incoming streams a peer can open.
Only streams with a stream ID less than ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "(max_streams * 4 +
first",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_stream",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_id",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_of",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_type",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": ")",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                          ],
                          "nodeName": "code",
                          "type": "Element",
                        },
                        {
                          "textContent": " can be opened; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#stream-id-types",
                          },
                          "children": [
                            {
                              "textContent": "Table 1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".  Initial
limits are set in the transport parameters; see
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#transport-parameter-definitions",
                          },
                          "children": [
                            {
                              "textContent": "Section 18.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ". Subsequent limits are advertised using
MAX_STREAMS frames; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#frame-max-streams",
                          },
                          "children": [
                            {
                              "textContent": "Section 19.11",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ". Separate limits apply to
unidirectional and bidirectional streams.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.6-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.6-2",
                      },
                      "children": [
                        {
                          "textContent": "If a max_streams transport parameter or a MAX_STREAMS frame is received with a
value greater than 2",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "60",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "sup",
                          "type": "Element",
                        },
                        {
                          "textContent": ", this would allow a maximum stream ID that
cannot be expressed as a variable-length integer; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#integer-encoding",
                          },
                          "children": [
                            {
                              "textContent": "Section 16",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".  If
either is received, the connection ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be closed immediately with a connection
error of type TRANSPORT",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_PARAMETER",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_ERROR",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " if the offending value was received in a
transport parameter or of type FRAME",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_ENCODING",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_ERROR",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " if it was received in a
frame; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#immediate-close",
                          },
                          "children": [
                            {
                              "textContent": "Section 10.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.6-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.6-3",
                      },
                      "children": [
                        {
                          "textContent": "Endpoints ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " exceed the limit set by their peer.  An endpoint that
receives a frame with a stream ID exceeding the limit it has sent ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " treat
this as a connection error of type STREAM",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_LIMIT",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_ERROR;",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#error-handling",
                          },
                          "children": [
                            {
                              "textContent": "Section 11",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
for details on error handling.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.6-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.6-4",
                      },
                      "children": [
                        {
                          "textContent": "Once a receiver advertises a stream limit using the MAX_STREAMS frame,
advertising a smaller limit has no effect.  MAX_STREAMS frames that do not
increase the stream limit ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be ignored.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.6-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.6-5",
                      },
                      "children": [
                        {
                          "textContent": "As with stream and connection flow control, this document leaves implementations
to decide when and how many streams should be advertised
to a peer via MAX_STREAMS.  Implementations might choose to increase limits as
streams are closed, to keep the number of streams available to peers roughly
consistent.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.6-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-4.6-6",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint that is unable to open a new stream due to the peer's limits ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "
send a STREAMS_BLOCKED frame (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#frame-streams-blocked",
                          },
                          "children": [
                            {
                              "textContent": "Section 19.14",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ").  This signal is
considered useful for debugging. An endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " wait to receive this
signal before advertising additional credit, since doing so will mean that the
peer will be blocked for at least an entire round trip, and potentially
indefinitely if the peer chooses not to send STREAMS_BLOCKED frames.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-4.6-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
          ],
          "nodeName": "section",
          "type": "Element",
        },
        {
          "textContent": "
",
          "type": "Text",
        },
      ],
      "nodeName": "div",
      "type": "Element",
    },
    {
      "textContent": "
",
      "type": "Text",
    },
    {
      "attributes": {
        "id": "connections",
      },
      "children": [
        {
          "textContent": "
",
          "type": "Text",
        },
        {
          "attributes": {
            "id": "section-5",
          },
          "children": [
            {
              "textContent": "
      ",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "name-connections",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "section-number selfRef",
                    "href": "#section-5",
                  },
                  "children": [
                    {
                      "textContent": "5. ",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "attributes": {
                    "class": "section-name selfRef",
                    "href": "#name-connections",
                  },
                  "children": [
                    {
                      "textContent": "Connections",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": "
      ",
                  "type": "Text",
                },
              ],
              "nodeName": "h2",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-5-1",
              },
              "children": [
                {
                  "textContent": "A QUIC connection is shared state between a client and a server.",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-5-1",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-5-2",
              },
              "children": [
                {
                  "textContent": "Each connection starts with a handshake phase, during which the two endpoints
establish a shared secret using the cryptographic handshake protocol
",
                  "type": "Text",
                },
                {
                  "attributes": {},
                  "children": [
                    {
                      "textContent": "[",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "class": "xref",
                        "href": "#QUIC-TLS",
                      },
                      "children": [
                        {
                          "textContent": "QUIC-TLS",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "a",
                      "type": "Element",
                    },
                    {
                      "textContent": "]",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "span",
                  "type": "Element",
                },
                {
                  "textContent": " and negotiate the application protocol. The handshake
(",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#handshake",
                  },
                  "children": [
                    {
                      "textContent": "Section 7",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ") confirms that both endpoints are willing to communicate
(",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#validate-handshake",
                  },
                  "children": [
                    {
                      "textContent": "Section 8.1",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ") and establishes parameters for the connection
(",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#transport-parameters",
                  },
                  "children": [
                    {
                      "textContent": "Section 7.4",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ").",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-5-2",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-5-3",
              },
              "children": [
                {
                  "textContent": "An application protocol can use the connection during the handshake phase with
some limitations.  0-RTT allows application data to be sent by a client before
receiving a response from the server.  However, 0-RTT provides no protection
against replay attacks; see ",
                  "type": "Text",
                },
                {
                  "attributes": {},
                  "children": [
                    {
                      "attributes": {
                        "class": "relref",
                        "href": "/info/rfc9001/#section-9.2",
                      },
                      "children": [
                        {
                          "textContent": "Section 9.2",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "a",
                      "type": "Element",
                    },
                    {
                      "textContent": " of [",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "class": "xref",
                        "href": "#QUIC-TLS",
                      },
                      "children": [
                        {
                          "textContent": "QUIC-TLS",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "a",
                      "type": "Element",
                    },
                    {
                      "textContent": "]",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "span",
                  "type": "Element",
                },
                {
                  "textContent": ".  A server can also send
application data to a client before it receives the final cryptographic
handshake messages that allow it to confirm the identity and liveness of the
client.  These capabilities allow an application protocol to offer the option of
trading some security guarantees for reduced latency.",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-5-3",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-5-4",
              },
              "children": [
                {
                  "textContent": "The use of connection IDs (",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#connection-id",
                  },
                  "children": [
                    {
                      "textContent": "Section 5.1",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ") allows connections to migrate to a
new network path, both as a direct choice of an endpoint and when forced by a
change in a middlebox.  ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#migration",
                  },
                  "children": [
                    {
                      "textContent": "Section 9",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": " describes mitigations for the security and
privacy issues associated with migration.",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-5-4",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-5-5",
              },
              "children": [
                {
                  "textContent": "For connections that are no longer needed or desired, there are several ways for
a client and server to terminate a connection, as described in ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#termination",
                  },
                  "children": [
                    {
                      "textContent": "Section 10",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ".",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-5-5",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "connection-id",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-5.1",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-connection-id",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-5.1",
                          },
                          "children": [
                            {
                              "textContent": "5.1. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-connection-id",
                          },
                          "children": [
                            {
                              "textContent": "Connection ID",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-5.1-1",
                      },
                      "children": [
                        {
                          "textContent": "Each connection possesses a set of connection identifiers, or connection IDs,
each of which can identify the connection.  Connection IDs are independently
selected by endpoints; each endpoint selects the connection IDs that its peer
uses.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-5.1-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-5.1-2",
                      },
                      "children": [
                        {
                          "textContent": "The primary function of a connection ID is to ensure that changes in addressing
at lower protocol layers (UDP, IP) do not cause packets for a QUIC
connection to be delivered to the wrong endpoint.  Each endpoint selects
connection IDs using an implementation",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "-specific",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " (and perhaps
deployment",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "-specific",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": ")",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " method that will allow packets with that connection ID to
be routed back to the endpoint and to be identified by the endpoint upon
receipt.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-5.1-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-5.1-3",
                      },
                      "children": [
                        {
                          "textContent": "Multiple connection IDs are used so that endpoints can send packets that cannot
be identified by an observer as being for the same connection without
cooperation from an endpoint; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#migration-linkability",
                          },
                          "children": [
                            {
                              "textContent": "Section 9.5",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-5.1-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-5.1-4",
                      },
                      "children": [
                        {
                          "textContent": "Connection IDs ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " contain any information that can be used by an external
observer (that is, one that does not cooperate with the issuer) to correlate
them with other connection IDs for the same connection.  As a trivial example,
this means the same connection ID ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be issued more than once on the same
connection.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-5.1-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-5.1-5",
                      },
                      "children": [
                        {
                          "textContent": "Packets with long headers include Source Connection ID and Destination
Connection ID fields.  These fields are used to set the connection IDs for new
connections; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#negotiating-connection-ids",
                          },
                          "children": [
                            {
                              "textContent": "Section 7.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": " for details.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-5.1-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-5.1-6",
                      },
                      "children": [
                        {
                          "textContent": "Packets with short headers (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#short-header",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ") only include the Destination
Connection ID and omit the explicit length.  The length of the Destination
Connection ID field is expected to be known to endpoints.  Endpoints using a
load balancer that routes based on connection ID could agree with the load
balancer on a fixed length for connection IDs or agree on an encoding scheme.
A fixed portion could encode an explicit length, which allows the entire
connection ID to vary in length and still be used by the load balancer.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-5.1-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-5.1-7",
                      },
                      "children": [
                        {
                          "textContent": "A Version Negotiation (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-version",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.2.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ") packet echoes the connection IDs
selected by the client, both to ensure correct routing toward the client and to
demonstrate that the packet is in response to a packet sent by the client.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-5.1-7",
                          },
                          "children": [
                            {
                              "textContent": "¶",
