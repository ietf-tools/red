                    {
                      "attributes": {
                        "id": "section-19.16-1",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint sends a RETIRE",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
