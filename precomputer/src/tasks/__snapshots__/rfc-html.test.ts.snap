                              "attributes": {
                                "id": "section-17.2-3.14.1",
                              },
                              "children": [
                                {
                                  "textContent": "The Destination Connection ID field follows the Destination Connection ID
Length field, which indicates the length of this field.
",
                                  "type": "Text",
                                },
                                {
