                            },
                            {
                              "attributes": {
                                "id": "section-19.19-6.2.1",
                              },
                              "children": [
                                {
                                  "textContent": "A variable-length integer that indicates the reason for closing this
connection.  A CONNECTION",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
