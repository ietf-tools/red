",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-number selfRef",
                                            "href": "#section-21.1.3.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "21.1.3.1. ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-name selfRef",
                                            "href": "#name-on-path-active-attacks",
                                          },
                                          "children": [
                                            {
                                              "textContent": "On-Path Active Attacks",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
            ",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "h5",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.1-1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "An attacker that can cause a packet it observes to no longer reach its intended
destination is considered an on-path attacker. When an attacker is present
between a client and server, endpoints are required to send packets through the
attacker to establish connectivity on a given path.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.1-1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.1-2",
                                      },
                                      "children": [
                                        {
                                          "textContent": "An on-path attacker can:",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.1-2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "data-component": "HorizontalScrollable",
                                      },
                                      "children": [
                                        {
                                          "attributes": {
                                            "class": "normal",
                                          },
                                          "children": [
                                            {
                                              "textContent": "
",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
