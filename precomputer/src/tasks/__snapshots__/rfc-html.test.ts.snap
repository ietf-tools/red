            {
              "attributes": {
                "id": "section-18-5",
              },
              "children": [
                {
                  "textContent": "The Transport Parameter Length field contains the length of the Transport
Parameter Value field in bytes.",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-18-5",
                  },
                  "children": [
                    {
