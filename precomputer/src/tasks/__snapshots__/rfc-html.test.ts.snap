                              "attributes": {
                                "id": "section-20.1-2.34.1",
                              },
                              "children": [
                                {
                                  "textContent": "An endpoint has determined that the network path is incapable of supporting
QUIC.  An endpoint is unlikely to receive a CONNECTION",
                                  "type": "Text",
                                },
                                {
