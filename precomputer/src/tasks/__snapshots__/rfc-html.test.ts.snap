                                      "children": [
                                        {
                                          "textContent": "An off-path attacker can:",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.2-2",
                                          },
