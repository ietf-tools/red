                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Spin Bit:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.6",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.3.1-4.6.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The third most significant bit (0x20) of byte 0 is the latency spin bit, set
as described in ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#spin-bit",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 17.4",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.3.1-4.6.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.7",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Reserved Bits:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.8",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.3.1-4.8.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The next two bits (those with a mask of 0x18) of byte 0 are reserved. These
bits are protected using header protection; see ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "attributes": {
                                                "class": "relref",
                                                "href": "/info/rfc9001/#section-5.4",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Section 5.4",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": " of [",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#QUIC-TLS",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "QUIC-TLS",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".
The value included prior to protection ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " be set to 0. An endpoint ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "bcp14",
                                          },
                                          "children": [
                                            {
                                              "textContent": "MUST",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " treat
receipt of a packet that has a non-zero value for these bits, after removing
both packet and header protection, as a connection error of type
PROTOCOL",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [],
                                          "nodeName": "wbr",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "_VIOLATION",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [],
                                          "nodeName": "wbr",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [],
                                          "nodeName": "wbr",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " Discarding such a packet after only removing header
protection can expose the endpoint to attacks; see ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "attributes": {
                                                "class": "relref",
                                                "href": "/info/rfc9001/#section-9.5",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Section 9.5",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": " of [",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#QUIC-TLS",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "QUIC-TLS",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.3.1-4.8.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.9",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Key Phase:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.10",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.3.1-4.10.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The next bit (0x04) of byte 0 indicates the key phase, which allows a
recipient of a packet to identify the packet protection keys that are used to
protect the packet.  See ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "textContent": "[",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#QUIC-TLS",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "QUIC-TLS",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " for details.  This bit is protected
using header protection; see ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "attributes": {
                                                "class": "relref",
                                                "href": "/info/rfc9001/#section-5.4",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Section 5.4",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": " of [",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#QUIC-TLS",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "QUIC-TLS",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.3.1-4.10.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.11",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Packet Number Length:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.12",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.3.1-4.12.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The least significant two bits (those with a mask of 0x03) of byte 0 contain
the length of the Packet Number field, encoded as an unsigned two-bit integer
that is one less than the length of the Packet Number field in bytes.  That
is, the length of the Packet Number field is the value of this field plus one.
These bits are protected using header protection; see ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "attributes": {
                                                "class": "relref",
                                                "href": "/info/rfc9001/#section-5.4",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Section 5.4",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": " of [",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#QUIC-TLS",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "QUIC-TLS",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ".",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.3.1-4.12.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.13",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Destination Connection ID:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.14",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.3.1-4.14.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The Destination Connection ID is a connection ID that is chosen by the
intended recipient of the packet.  See ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#connection-id",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 5.1",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " for more details.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.3.1-4.14.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.15",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Packet Number:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.16",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.3.1-4.16.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The Packet Number field is 1 to 4 bytes long. The packet number is protected
using header protection; see
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {},
                                          "children": [
                                            {
                                              "attributes": {
                                                "class": "relref",
                                                "href": "/info/rfc9001/#section-5.4",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Section 5.4",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": " of [",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "xref",
                                                "href": "#QUIC-TLS",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "QUIC-TLS",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "a",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "]",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "span",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ". The length of the Packet Number field is encoded
in Packet Number Length field. See ",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#packet-encoding",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 17.1",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": " for details.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.3.1-4.16.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.17",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Packet Payload:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-17.3.1-4.18",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-17.3.1-4.18.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "1-RTT packets always include a 1-RTT protected payload.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-17.3.1-4.18.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "break",
                                  },
                                  "children": [],
                                  "nodeName": "dd",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "dl",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-17.3.1-5",
                              },
                              "children": [
                                {
                                  "textContent": "The header form bit and the Destination Connection ID field of a short header
packet are version independent.  The remaining fields are specific to the
selected QUIC version.  See ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "[",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#QUIC-INVARIANTS",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC-INVARIANTS",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " for details on how packets from
different versions of QUIC are interpreted.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-17.3.1-5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "spin-bit",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-17.4",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-latency-spin-bit",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-17.4",
                          },
                          "children": [
                            {
                              "textContent": "17.4. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-latency-spin-bit",
                          },
                          "children": [
                            {
                              "textContent": "Latency Spin Bit",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.4-1",
                      },
                      "children": [
                        {
                          "textContent": "The latency spin bit, which is defined for 1-RTT packets (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-1rtt",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.3.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "),
enables passive latency monitoring from observation points on the network path
throughout the duration of a connection. The server reflects the spin value
received, while the client "spins" it after one RTT. On-path observers can
measure the time between two spin bit toggle events to estimate the end-to-end
RTT of a connection.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.4-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.4-2",
                      },
                      "children": [
                        {
                          "textContent": "The spin bit is only present in 1-RTT packets, since it is possible to measure
the initial RTT of a connection by observing the handshake. Therefore, the spin
bit is available after version negotiation and connection establishment are
completed. On-path measurement and use of the latency spin bit are further
discussed in ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#QUIC-MANAGEABILITY",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "-MANAGEABILITY",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.4-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.4-3",
                      },
                      "children": [
                        {
                          "textContent": "The spin bit is an ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "OPTIONAL",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " feature of this version of QUIC. An endpoint that
does not support this feature ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " disable it, as defined below.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.4-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.4-4",
                      },
                      "children": [
                        {
                          "textContent": "Each endpoint unilaterally decides if the spin bit is enabled or disabled for a
connection. Implementations ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " allow administrators of clients and servers to
disable the spin bit either globally or on a per-connection basis. Even when the
spin bit is not disabled by the administrator, endpoints ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " disable their use
of the spin bit for a random selection of at least one in every 16 network
paths, or for one in every 16 connection IDs, in order to ensure that QUIC
connections that disable the spin bit are commonly observed on the network.  As
each endpoint disables the spin bit independently, this ensures that the spin
bit signal is disabled on approximately one in eight network paths.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.4-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.4-5",
                      },
                      "children": [
                        {
                          "textContent": "When the spin bit is disabled, endpoints ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MAY",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " set the spin bit to any value and
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " ignore any incoming value. It is ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "RECOMMENDED",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " that endpoints set the spin
bit to a random value either chosen independently for each packet or chosen
independently for each connection ID.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.4-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.4-6",
                      },
                      "children": [
                        {
                          "textContent": "If the spin bit is enabled for the connection, the endpoint maintains a spin
value for each network path and sets the spin bit in the packet header to the
currently stored value when a 1-RTT packet is sent on that path. The spin value
is initialized to 0 in the endpoint for each network path. Each endpoint also
remembers the highest packet number seen from its peer on each path.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.4-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.4-7",
                      },
                      "children": [
                        {
                          "textContent": "When a server receives a 1-RTT packet that increases the highest packet number
seen by the server from the client on a given network path, it sets the spin
value for that path to be equal to the spin bit in the received packet.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.4-7",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.4-8",
                      },
                      "children": [
                        {
                          "textContent": "When a client receives a 1-RTT packet that increases the highest packet number
seen by the client from the server on a given network path, it sets the spin
value for that path to the inverse of the spin bit in the received packet.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.4-8",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-17.4-9",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint resets the spin value for a network path to 0 when changing the
connection ID being used on that network path.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-17.4-9",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
          ],
          "nodeName": "section",
          "type": "Element",
        },
        {
          "textContent": "
",
          "type": "Text",
        },
      ],
      "nodeName": "div",
      "type": "Element",
    },
    {
      "textContent": "
",
      "type": "Text",
    },
    {
      "attributes": {
        "id": "transport-parameter-encoding",
      },
      "children": [
        {
          "textContent": "
",
          "type": "Text",
        },
        {
          "attributes": {
            "id": "section-18",
          },
          "children": [
            {
              "textContent": "
      ",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "name-transport-parameter-encodin",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "section-number selfRef",
                    "href": "#section-18",
                  },
                  "children": [
                    {
                      "textContent": "18. ",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "attributes": {
                    "class": "section-name selfRef",
                    "href": "#name-transport-parameter-encodin",
                  },
                  "children": [
                    {
                      "textContent": "Transport Parameter Encoding",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": "
      ",
                  "type": "Text",
                },
              ],
              "nodeName": "h2",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-18-1",
              },
              "children": [
                {
                  "textContent": "The extension_data field of the quic",
                  "type": "Text",
                },
                {
                  "attributes": {},
                  "children": [],
                  "nodeName": "wbr",
                  "type": "Element",
                },
                {
                  "textContent": "_transport",
                  "type": "Text",
                },
                {
                  "attributes": {},
                  "children": [],
                  "nodeName": "wbr",
                  "type": "Element",
                },
                {
                  "textContent": "_parameters",
                  "type": "Text",
                },
                {
                  "attributes": {},
                  "children": [],
                  "nodeName": "wbr",
                  "type": "Element",
                },
                {
                  "textContent": " extension defined in
",
                  "type": "Text",
                },
                {
                  "attributes": {},
                  "children": [
                    {
                      "textContent": "[",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "class": "xref",
                        "href": "#QUIC-TLS",
                      },
                      "children": [
                        {
                          "textContent": "QUIC-TLS",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "a",
                      "type": "Element",
                    },
                    {
                      "textContent": "]",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "span",
                  "type": "Element",
                },
                {
                  "textContent": " contains the QUIC transport parameters. They are encoded as a
sequence of transport parameters, as shown in ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#transport-parameter-sequence",
                  },
                  "children": [
                    {
                      "textContent": "Figure 20",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ":",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-18-1",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "name-sequence-of-transport-param",
              },
              "children": [],
              "nodeName": "span",
              "type": "Element",
            },
            {
              "attributes": {
                "id": "transport-parameter-sequence",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "figure-20",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "class": "artwork art-text alignLeft",
                        "id": "section-18-2.1",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "data-component": "HorizontalScrollable",
                          },
                          "children": [
                            {
                              "attributes": {},
                              "children": [
                                {
                                  "textContent": "Transport Parameters {
  Transport Parameter (..) ...,
}
",
                                  "type": "Text",
                                },
                              ],
