            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-12.3-5.4.1",
                              },
                              "children": [
                                {
                                  "textContent": "All Handshake packets (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
