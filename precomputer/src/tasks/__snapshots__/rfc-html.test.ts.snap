            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-19.7-5.2.1",
                              },
                              "children": [
                                {
                                  "textContent": "A variable-length integer specifying the length of the token in bytes.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
