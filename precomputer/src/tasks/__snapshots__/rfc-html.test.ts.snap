                                  "type": "Element",
                                },
                                {
                                  "textContent": "
frames.
The value of the active",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
