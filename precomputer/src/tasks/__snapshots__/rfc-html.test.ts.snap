    {
      "attributes": {
        "id": "packets-frames",
      },
      "children": [
        {
          "textContent": "
",
          "type": "Text",
        },
        {
          "attributes": {
            "id": "section-12",
          },
          "children": [
            {
              "textContent": "
      ",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "name-packets-and-frames",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "section-number selfRef",
                    "href": "#section-12",
                  },
                  "children": [
                    {
                      "textContent": "12. ",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "attributes": {
                    "class": "section-name selfRef",
                    "href": "#name-packets-and-frames",
                  },
                  "children": [
                    {
                      "textContent": "Packets and Frames",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": "
      ",
                  "type": "Text",
                },
              ],
              "nodeName": "h2",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-12-1",
              },
              "children": [
                {
                  "textContent": "QUIC endpoints communicate by exchanging packets. Packets have confidentiality
and integrity protection; see ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#packet-protected",
                  },
                  "children": [
                    {
                      "textContent": "Section 12.1",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ". Packets are carried in UDP
datagrams; see ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#packet-coalesce",
                  },
                  "children": [
                    {
                      "textContent": "Section 12.2",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ".",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-12-1",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-12-2",
              },
              "children": [
                {
                  "textContent": "This version of QUIC uses the long packet header during connection
establishment; see ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#long-header",
                  },
                  "children": [
                    {
                      "textContent": "Section 17.2",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ".  Packets with the long header are Initial
(",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#packet-initial",
                  },
                  "children": [
                    {
                      "textContent": "Section 17.2.2",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": "), 0-RTT (",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#packet-0rtt",
                  },
                  "children": [
                    {
                      "textContent": "Section 17.2.3",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": "), Handshake (",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#packet-handshake",
                  },
                  "children": [
                    {
                      "textContent": "Section 17.2.4",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": "),
and Retry (",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#packet-retry",
                  },
                  "children": [
                    {
                      "textContent": "Section 17.2.5",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ").  Version negotiation uses a version",
                  "type": "Text",
                },
                {
                  "attributes": {},
                  "children": [],
                  "nodeName": "wbr",
                  "type": "Element",
                },
                {
                  "textContent": "-independent",
                  "type": "Text",
                },
                {
                  "attributes": {},
                  "children": [],
                  "nodeName": "wbr",
                  "type": "Element",
                },
                {
                  "textContent": "
packet with a long header; see ",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#packet-version",
                  },
                  "children": [
                    {
                      "textContent": "Section 17.2.1",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ".",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-12-2",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-12-3",
              },
              "children": [
                {
                  "textContent": "Packets with the short header are designed for minimal overhead and are used
after a connection is established and 1-RTT keys are available; see
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#short-header",
                  },
                  "children": [
                    {
                      "textContent": "Section 17.3",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ".",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-12-3",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "packet-protected",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-12.1",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-protected-packets",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-12.1",
                          },
                          "children": [
                            {
                              "textContent": "12.1. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-protected-packets",
                          },
                          "children": [
                            {
                              "textContent": "Protected Packets",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.1-1",
                      },
                      "children": [
                        {
                          "textContent": "QUIC packets have different levels of cryptographic protection based on the
type of packet. Details of packet protection are found in ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#QUIC-TLS",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC-TLS",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "; this
section includes an overview of the protections that are provided.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.1-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.1-2",
                      },
                      "children": [
                        {
                          "textContent": "Version Negotiation packets have no cryptographic protection; see
",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#QUIC-INVARIANTS",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC-INVARIANTS",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.1-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.1-3",
                      },
                      "children": [
                        {
                          "textContent": "Retry packets use an AEAD function ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#AEAD",
                              },
                              "children": [
                                {
                                  "textContent": "AEAD",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " to protect against
accidental modification.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.1-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.1-4",
                      },
                      "children": [
                        {
                          "textContent": "Initial packets use an AEAD function, the keys for which are derived using a
value that is visible on the wire. Initial packets therefore do not have
effective confidentiality protection. Initial protection exists to ensure that
the sender of the packet is on the network path. Any entity that receives an
Initial packet from a client can recover the keys that will allow them to both
read the contents of the packet and generate Initial packets that will be
successfully authenticated at either endpoint.  The AEAD also protects Initial
packets against accidental modification.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.1-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.1-5",
                      },
                      "children": [
                        {
                          "textContent": "All other packets are protected with keys derived from the cryptographic
handshake.  The cryptographic handshake ensures that only the communicating
endpoints receive the corresponding keys for Handshake, 0-RTT, and 1-RTT
packets.  Packets protected with 0-RTT and 1-RTT keys have strong
confidentiality and integrity protection.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.1-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.1-6",
                      },
                      "children": [
                        {
                          "textContent": "The Packet Number field that appears in some packet types has alternative
confidentiality protection that is applied as part of header protection; see
",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "attributes": {
                                "class": "relref",
                                "href": "/info/rfc9001/#section-5.4",
                              },
                              "children": [
                                {
                                  "textContent": "Section 5.4",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": " of [",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#QUIC-TLS",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC-TLS",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " for details. The underlying packet number increases
with each packet sent in a given packet number space; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-numbers",
                          },
                          "children": [
                            {
                              "textContent": "Section 12.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": " for
details.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.1-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "packet-coalesce",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-12.2",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-coalescing-packets",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-12.2",
                          },
                          "children": [
                            {
                              "textContent": "12.2. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-coalescing-packets",
                          },
                          "children": [
                            {
                              "textContent": "Coalescing Packets",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.2-1",
                      },
                      "children": [
                        {
                          "textContent": "Initial (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-initial",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.2.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "), 0-RTT (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-0rtt",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.2.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "), and Handshake
(",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-handshake",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.2.4",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ") packets contain a Length field that determines the end
of the packet.  The length includes both the Packet Number and Payload
fields, both of which are confidentiality protected and initially of unknown
length. The length of the Payload field is learned once header protection is
removed.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.2-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.2-2",
                      },
                      "children": [
                        {
                          "textContent": "Using the Length field, a sender can coalesce multiple QUIC packets into one UDP
datagram.  This can reduce the number of UDP datagrams needed to complete the
cryptographic handshake and start sending data.  This can also be used to
construct Path Maximum Transmission Unit (PMTU) probes; see
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#pmtu-probes-src-cid",
                          },
                          "children": [
                            {
                              "textContent": "Section 14.4.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".  Receivers ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be able to process coalesced packets.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.2-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.2-3",
                      },
                      "children": [
                        {
                          "textContent": "Coalescing packets in order of increasing encryption levels (Initial, 0-RTT,
Handshake, 1-RTT; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "attributes": {
                                "class": "relref",
                                "href": "/info/rfc9001/#section-4.1.4",
                              },
                              "children": [
                                {
                                  "textContent": "Section 4.1.4",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": " of [",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#QUIC-TLS",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC-TLS",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": ") makes it more likely that
the receiver will be able to process all the packets in a single pass. A packet
with a short header does not include a length, so it can only be the last packet
included in a UDP datagram.  An endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " include multiple frames in a
single packet if they are to be sent at the same encryption level, instead of
coalescing multiple packets at the same encryption level.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.2-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.2-4",
                      },
                      "children": [
                        {
                          "textContent": "Receivers ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MAY",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " route based on the information in the first packet contained in a
UDP datagram.  Senders ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " coalesce QUIC packets with different connection
IDs into a single UDP datagram.  Receivers ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " ignore any subsequent packets
with a different Destination Connection ID than the first packet in the
datagram.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.2-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.2-5",
                      },
                      "children": [
                        {
                          "textContent": "Every QUIC packet that is coalesced into a single UDP datagram is separate and
complete.  The receiver of coalesced QUIC packets ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " individually process each
QUIC packet and separately acknowledge them, as if they were received as the
payload of different UDP datagrams.  For example, if decryption fails (because
the keys are not available or for any other reason), the receiver ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MAY",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " either
discard or buffer the packet for later processing and ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " attempt to process
the remaining packets.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.2-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.2-6",
                      },
                      "children": [
                        {
                          "textContent": "Retry packets (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-retry",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.2.5",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "), Version Negotiation packets
(",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-version",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.2.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "), and packets with a short header (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#short-header",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ") do not
contain a Length field and so cannot be followed by other packets in the same
UDP datagram.  Note also that there is no situation where a Retry or Version
Negotiation packet is coalesced with another packet.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.2-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "packet-numbers",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-12.3",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-packet-numbers",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-12.3",
                          },
                          "children": [
                            {
                              "textContent": "12.3. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-packet-numbers",
                          },
                          "children": [
                            {
                              "textContent": "Packet Numbers",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.3-1",
                      },
                      "children": [
                        {
                          "textContent": "The packet number is an integer in the range 0 to 2",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "62",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "sup",
                          "type": "Element",
                        },
                        {
                          "textContent": "-1.  This number
is used in determining the cryptographic nonce for packet protection.  Each
endpoint maintains a separate packet number for sending and receiving.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.3-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.3-2",
                      },
                      "children": [
                        {
                          "textContent": "Packet numbers are limited to this range because they need to be representable
in whole in the Largest Acknowledged field of an ACK frame (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#frame-ack",
                          },
                          "children": [
                            {
                              "textContent": "Section 19.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ").
When present in a long or short header, however, packet numbers are reduced and
encoded in 1 to 4 bytes; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-encoding",
                          },
                          "children": [
                            {
                              "textContent": "Section 17.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-12.3-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-12.3-3",
                      },
                      "children": [
                        {
                          "textContent": "Version Negotiation (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#packet-version",
                          },
                          "children": [
