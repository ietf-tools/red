                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be designed to minimize the chances of
linkability with a previously used flow label, as a stable flow label would
enable correlating activity on multiple paths; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#migration-linkability",
                          },
