                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "_CONNECTION",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "_ID",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " frame.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-9.6.1-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
