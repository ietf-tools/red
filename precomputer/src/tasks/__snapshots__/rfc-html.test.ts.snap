                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-19.4-3",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint that receives a RESET_STREAM frame for a send-only stream ",
