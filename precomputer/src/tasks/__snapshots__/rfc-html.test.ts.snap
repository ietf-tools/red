                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-5.1.1-3",
                              },
                              "children": [
                                {
                                  "textContent": "When an endpoint issues a connection ID, it ",
