                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.1-3.7",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Split and merge datagrams along packet boundaries",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.1-3.7",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
            ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "ul",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.1-4",
                                      },
                                      "children": [
                                        {
                                          "textContent": "An on-path attacker cannot:",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.1-4",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "data-component": "HorizontalScrollable",
                                      },
                                      "children": [
                                        {
                                          "attributes": {
                                            "class": "normal",
                                          },
                                          "children": [
                                            {
                                              "textContent": "
",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.1-5.1",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Modify an authenticated portion of a packet and cause the recipient to accept
that packet",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.1-5.1",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
            ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "ul",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.1-6",
                                      },
                                      "children": [
                                        {
                                          "textContent": "An on-path attacker has the opportunity to modify the packets that it observes;
however, any modifications to an authenticated portion of a packet will cause it
to be dropped by the receiving endpoint as invalid, as packet payloads are both
authenticated and encrypted.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.1-6",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.1-7",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC aims to constrain the capabilities of an on-path attacker as follows:",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.1-7",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "data-component": "HorizontalScrollable",
                                      },
                                      "children": [
                                        {
                                          "attributes": {
                                            "class": "normal type-1",
                                            "id": "section-21.1.3.1-8",
                                            "start": "1",
                                            "type": "1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.1-8.1",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An on-path attacker can prevent the use of a path for a connection,
causing the connection to fail if it cannot use a different path
that does not contain the attacker. This can be achieved by
dropping all packets, modifying them so that they fail to decrypt,
or other methods.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.1-8.1",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.1-8.2",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An on-path attacker can prevent migration to a new path for which the
attacker is also on-path by causing path validation to fail on the new path.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.1-8.2",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.1-8.3",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An on-path attacker cannot prevent a client from migrating to a path for
which the attacker is not on-path.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.1-8.3",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.1-8.4",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An on-path attacker can reduce the throughput of a connection by delaying
packets or dropping them.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.1-8.4",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.1-8.5",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An on-path attacker cannot cause an endpoint to accept a packet for which it
has modified an authenticated portion of that packet.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.1-8.5",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
            ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "ol",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "section",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "off-path-active-attacks",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-21.1.3.2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "name-off-path-active-attacks",
                                      },
                                      "children": [
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-number selfRef",
                                            "href": "#section-21.1.3.2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "21.1.3.2. ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-name selfRef",
                                            "href": "#name-off-path-active-attacks",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Off-Path Active Attacks",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
            ",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "h5",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.2-1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "An off-path attacker is not directly on the path between a client and server
but could be able to obtain copies of some or all packets sent between the
client and the server. It is also able to send copies of those packets to
either endpoint.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.2-1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
