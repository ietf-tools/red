                                    "data-component": "HorizontalScrollable",
                                  },
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "sourcecode lang-pseudocode",
                                      },
                                      "children": [
                                        {
                                          "textContent": "ReadVarint(data):
  // The length of variable-length integers is encoded in the
  // first two bits of the first byte.
  v = data.next_byte()
  prefix = v >> 6
  length = 1 << prefix

  // Once the length is known, remove these bits and read any
  // remaining bytes.
  v = v & 0x3f
  repeat length-1 times:
    v = (v << 8) + data.next_byte()
  return v
",
                                          "type": "Text",
                                        },
                                      ],
