                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.2",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.2.1",
                              },
                              "children": [
                                {
                                  "textContent": "This parameter is the value of the Destination Connection ID field from the
first Initial packet sent by the client; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#cid-auth",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 7.3",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  This transport
parameter is only sent by a server.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.2.1",
                                  },
                                  "children": [
