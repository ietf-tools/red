                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.1",
                          },
                          "children": [
                            {
                              "textContent": "original",
                              "type": "Text",
                            },
