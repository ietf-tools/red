                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " initiate path validation to the client's new address upon
receiving a probe packet from a different address; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
