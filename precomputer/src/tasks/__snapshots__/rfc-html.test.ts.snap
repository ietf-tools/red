                          },
                          "children": [
                            {
                              "textContent": "19.20. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-handshake_done-frames",
                          },
                          "children": [
                            {
                              "textContent": "HANDSHAKE_DONE Frames",
                              "type": "Text",
