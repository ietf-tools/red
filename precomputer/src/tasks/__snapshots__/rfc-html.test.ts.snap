                            },
                            {
                              "attributes": {
                                "id": "section-9.6.1-1",
                              },
                              "children": [
                                {
                                  "textContent": "A server conveys a preferred address by including the preferred",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
