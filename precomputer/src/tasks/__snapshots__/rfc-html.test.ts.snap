                            },
                            {
                              "attributes": {
                                "id": "section-9.6.3-3",
                              },
                              "children": [
                                {
                                  "textContent": "If packets received at the server's preferred address have a different source
address than observed from the client during the handshake, the server ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
protect against potential attacks as described in Sections ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#address-spoofing",
                                  },
                                  "children": [
                                    {
