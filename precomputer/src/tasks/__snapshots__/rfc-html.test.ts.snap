            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-19.14-6.2.1",
                              },
                              "children": [
                                {
                                  "textContent": "A variable-length integer indicating the maximum number of streams allowed at
the time the frame was sent.  This value cannot exceed 2",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "60",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "sup",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ", as it
is not possible to encode stream IDs larger than 2",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "62",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "sup",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "-1.  Receipt of
a frame that encodes a larger stream ID ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " be treated as a connection error
of type STREAM",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
