                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-19.4-1",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint uses a RESET_STREAM frame (type=0x04) to abruptly terminate the
sending part of a stream.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-19.4-1",
                          },
                          "children": [
                            {
