          "children": [
            {
              "attributes": {
                "href": "/info/rfc2000/",
              },
              "children": [
                {
                  "textContent": "RFC 2000",
                  "type": "Text",
                },
              ],
              "nodeName": "a",
              "type": "Element",
            },
            {
              "textContent": "                   Internet Standards              February 1997",
