",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "dl",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-1.3-5",
                      },
                      "children": [
                        {
                          "textContent": "This document uses network byte order (that is, big endian) values.  Fields
are placed starting from the high-order bits of each byte.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-1.3-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-1.3-6",
                      },
                      "children": [
                        {
                          "textContent": "By convention, individual fields reference a complex field by using the name of
the complex field.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-1.3-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-1.3-7",
                      },
                      "children": [
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#fig-ex-format",
                          },
                          "children": [
                            {
                              "textContent": "Figure 1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": " provides an example:",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-1.3-7",
                          },
                          "children": [
