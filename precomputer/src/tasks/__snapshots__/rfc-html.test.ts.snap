                                            "href": "#figure-18",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Figure 18",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ":
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
