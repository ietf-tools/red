                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-20.1-2.5",
                          },
                          "children": [
                            {
                              "textContent": "CONNECTION",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_REFUSED",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x02):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-20.1-2.6",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
