                        {
                          "attributes": {
                            "id": "section-17.2-3.7",
                          },
                          "children": [
                            {
                              "textContent": "Type-Specific Bits:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
