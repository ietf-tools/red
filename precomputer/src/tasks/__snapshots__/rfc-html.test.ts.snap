                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x03):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.8",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.8.1",
                              },
                              "children": [
                                {
                                  "textContent": "The maximum UDP payload size parameter is an integer value that limits the
size of UDP payloads that the endpoint is willing to receive.  UDP datagrams
with payloads larger than this limit are not likely to be processed by the
receiver.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.8.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.9",
                          },
                          "children": [],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.10",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.10.1",
                              },
                              "children": [
                                {
                                  "textContent": "The default for this parameter is the maximum permitted UDP payload of 65527.
Values below 1200 are invalid.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.10.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.11",
                          },
                          "children": [],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.12",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.12.1",
                              },
                              "children": [
                                {
                                  "textContent": "This limit does act as an additional constraint on datagram size in the same
way as the path MTU, but it is a property of the endpoint and not the path;
see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#datagram-size",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 14",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  It is expected that this is the space an endpoint
dedicates to holding incoming packets.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.12.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.13",
                          },
                          "children": [
                            {
                              "textContent": "initial_max_data (0x04):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.14",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.14.1",
                              },
                              "children": [
                                {
                                  "textContent": "The initial maximum data parameter is an integer value that contains the
initial value for the maximum amount of data that can be sent on the
connection.  This is equivalent to sending a MAX_DATA (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#frame-max-data",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 19.9",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") for
the connection immediately after completing the handshake.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.14.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.15",
                          },
                          "children": [
                            {
                              "textContent": "initial",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_max",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_stream",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_data",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_bidi",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_local",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x05):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.16",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.16.1",
                              },
                              "children": [
                                {
                                  "textContent": "This parameter is an integer value specifying the initial flow control limit
for locally initiated bidirectional streams.  This limit applies to newly
created bidirectional streams opened by the endpoint that sends the transport
parameter.  In client transport parameters, this applies to streams with an
identifier with the least significant two bits set to 0x00; in server
transport parameters, this applies to streams with the least significant two
bits set to 0x01.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.16.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.17",
                          },
                          "children": [
                            {
                              "textContent": "initial",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_max",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_stream",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_data",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_bidi",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_remote",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x06):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.18",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.18.1",
                              },
                              "children": [
                                {
                                  "textContent": "This parameter is an integer value specifying the initial flow control limit
for peer-initiated bidirectional streams.  This limit applies to newly created
bidirectional streams opened by the endpoint that receives the transport
parameter.  In client transport parameters, this applies to streams with an
identifier with the least significant two bits set to 0x01; in server
transport parameters, this applies to streams with the least significant two
bits set to 0x00.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.18.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.19",
                          },
                          "children": [
                            {
                              "textContent": "initial",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_max",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_stream",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_data",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_uni",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x07):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.20",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.20.1",
                              },
                              "children": [
                                {
                                  "textContent": "This parameter is an integer value specifying the initial flow control limit
for unidirectional streams.  This limit applies to newly created
unidirectional streams opened by the endpoint that receives the transport
parameter.  In client transport parameters, this applies to streams with an
identifier with the least significant two bits set to 0x03; in server
transport parameters, this applies to streams with the least significant two
bits set to 0x02.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.20.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.21",
                          },
                          "children": [
                            {
                              "textContent": "initial",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_max",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_streams",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_bidi",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x08):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.22",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.22.1",
                              },
                              "children": [
                                {
                                  "textContent": "The initial maximum bidirectional streams parameter is an integer value that
contains the initial maximum number of bidirectional streams the endpoint
that receives this transport parameter is
permitted to initiate.  If this parameter is absent or zero, the peer cannot
open bidirectional streams until a MAX_STREAMS frame is sent.  Setting this
parameter is equivalent to sending a MAX_STREAMS (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#frame-max-streams",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 19.11",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") of
the corresponding type with the same value.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.22.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.23",
                          },
                          "children": [
                            {
                              "textContent": "initial",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_max",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_streams",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_uni",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x09):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.24",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.24.1",
                              },
                              "children": [
                                {
                                  "textContent": "The initial maximum unidirectional streams parameter is an integer value that
contains the initial maximum number of unidirectional streams the endpoint
that receives this transport parameter is
permitted to initiate.  If this parameter is absent or zero, the peer cannot
open unidirectional streams until a MAX_STREAMS frame is sent.  Setting this
parameter is equivalent to sending a MAX_STREAMS (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#frame-max-streams",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 19.11",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") of
the corresponding type with the same value.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.24.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.25",
                          },
                          "children": [
                            {
                              "textContent": "ack",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_delay",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_exponent",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x0a):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.26",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.26.1",
                              },
                              "children": [
                                {
                                  "textContent": "The acknowledgment delay exponent is an integer value indicating an exponent
used to decode the ACK Delay field in the ACK frame (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#frame-ack",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 19.3",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "). If this
value is absent, a default value of 3 is assumed (indicating a multiplier of
8). Values above 20 are invalid.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.26.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.27",
                          },
                          "children": [
                            {
                              "textContent": "max_ack_delay (0x0b):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.28",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.28.1",
                              },
                              "children": [
                                {
                                  "textContent": "The maximum acknowledgment delay is an integer value indicating the maximum
amount of time in milliseconds by which the endpoint will delay sending
acknowledgments",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "  This value ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " include the receiver's expected delays in
alarms firing.  For example, if a receiver sets a timer for 5ms and alarms
commonly fire up to 1ms late, then it should send a max_ack_delay of 6ms.  If
this value is absent, a default of 25 milliseconds is assumed. Values of
2",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "14",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "sup",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " or greater are invalid.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.28.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.29",
                          },
                          "children": [
                            {
                              "textContent": "disable",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_active",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_migration",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x0c):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.30",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.30.1",
                              },
                              "children": [
                                {
                                  "textContent": "The disable active migration transport parameter is included if the endpoint
does not support active connection migration (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#migration",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 9",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") on the address
being used during the handshake.  An endpoint that receives this transport
parameter ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST NOT",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " use a new local address when sending to the address that
the peer used during the handshake.  This transport parameter does not
prohibit connection migration after a client has acted on a preferred",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "_address",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
transport parameter.  This parameter is a zero-length value.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.30.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.31",
                          },
                          "children": [
                            {
                              "textContent": "preferred",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": "_address",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
                              "type": "Element",
                            },
                            {
                              "textContent": " (0x0d):",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.32",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.32.1",
                              },
                              "children": [
                                {
                                  "textContent": "The server's preferred address is used to effect a change in server address at
the end of the handshake, as described in ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#preferred-address",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 9.6",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".  This
transport parameter is only sent by a server.  Servers ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " choose to only send
a preferred address of one address family by sending an all-zero address and
port (0.0.0.0:0 or [::]:0) for the other family. IP addresses are encoded in
network byte order.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.32.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.33",
                          },
                          "children": [],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.34",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.34.1",
                              },
                              "children": [
                                {
                                  "textContent": "The preferred",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "_address",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " transport parameter contains an address and port for
both IPv4 and IPv6.  The four-byte IPv4 Address field is followed by the
associated two-byte IPv4 Port field.  This is followed by a 16-byte IPv6
Address field and two-byte IPv6 Port field.  After address and port pairs, a
Connection ID Length field describes the length of the following Connection ID
field.  Finally, a 16-byte Stateless Reset Token field includes the stateless
reset token associated with the connection ID.  The format of this transport
parameter is shown in ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#fig-preferred-address",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Figure 22",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " below.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.34.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.35",
                          },
                          "children": [],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.36",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.36.1",
                              },
                              "children": [
                                {
                                  "textContent": "The Connection ID field and the Stateless Reset Token field contain an
alternative connection ID that has a sequence number of 1; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#issue-cid",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 5.1.1",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".
Having these values sent alongside the preferred address ensures that there
will be at least one unused active connection ID when the client initiates
migration to the preferred address.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-18.2-4.36.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.37",
                          },
                          "children": [],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.38",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-18.2-4.38.1",
                              },
                              "children": [
                                {
                                  "textContent": "The Connection ID and Stateless Reset Token fields of a preferred address are
identical in syntax and semantics to the corresponding fields of a
NEW",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "_CONNECTION",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "_ID",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
