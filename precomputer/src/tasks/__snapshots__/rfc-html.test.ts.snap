                      },
                      "children": [
                        {
                          "textContent": "Including 64 bits of entropy in a PATH_CHALLENGE frame ensures that it is easier
to receive the packet than it is to guess the value correctly.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
