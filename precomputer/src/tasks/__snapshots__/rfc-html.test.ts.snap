              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.2-3.2",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Inject new packets",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-3.2",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.2-3.3",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Reorder injected packets",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-3.3",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
            ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "ul",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.2-4",
                                      },
                                      "children": [
                                        {
                                          "textContent": "An off-path attacker cannot:",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.2-4",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "data-component": "HorizontalScrollable",
                                      },
                                      "children": [
                                        {
                                          "attributes": {
                                            "class": "normal",
                                          },
                                          "children": [
                                            {
                                              "textContent": "
",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.2-5.1",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Modify packets sent by endpoints",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-5.1",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.2-5.2",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Delay packets",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-5.2",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.2-5.3",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Drop packets",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-5.3",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.2-5.4",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Reorder original packets",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-5.4",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
            ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "ul",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.2-6",
                                      },
                                      "children": [
                                        {
                                          "textContent": "An off-path attacker can create modified copies of packets that it has observed
and inject those copies into the network, potentially with spoofed source and
destination addresses.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.2-6",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.2-7",
                                      },
                                      "children": [
                                        {
                                          "textContent": "For the purposes of this discussion, it is assumed that an off-path attacker has
the ability to inject a modified copy of a packet into the network that will
reach the destination endpoint prior to the arrival of the original packet
observed by the attacker. In other words, an attacker has the ability to
consistently "win" a race with the legitimate packets between the endpoints,
potentially causing the original packet to be ignored by the recipient.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.2-7",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.2-8",
                                      },
                                      "children": [
                                        {
                                          "textContent": "It is also assumed that an attacker has the resources necessary to affect NAT
state. In particular, an attacker can cause an endpoint to lose its NAT binding
and then obtain the same port for use with its own traffic.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.2-8",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.2-9",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC aims to constrain the capabilities of an off-path attacker as follows:",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.2-9",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "data-component": "HorizontalScrollable",
                                      },
                                      "children": [
                                        {
                                          "attributes": {
                                            "class": "normal type-1",
                                            "id": "section-21.1.3.2-10",
                                            "start": "1",
                                            "type": "1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.2-10.1",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An off-path attacker can race packets and attempt to become a "limited"
on-path attacker.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-10.1",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.2-10.2",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An off-path attacker can cause path validation to succeed for forwarded
packets with the source address listed as the off-path attacker as long as
it can provide improved connectivity between the client and the server.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-10.2",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.2-10.3",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An off-path attacker cannot cause a connection to close once the handshake
has completed.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-10.3",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.2-10.4",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An off-path attacker cannot cause migration to a new path to fail if it
cannot observe the new path.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-10.4",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.2-10.5",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An off-path attacker can become a limited on-path attacker during migration
to a new path for which it is also an off-path attacker.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-10.5",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.2-10.6",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "An off-path attacker can become a limited on-path attacker by affecting
shared NAT state such that it sends packets to the server from the same IP
address and port that the client originally used.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.2-10.6",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
            ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "ol",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "section",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "limited-on-path-active-attacks",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-21.1.3.3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "name-limited-on-path-active-atta",
                                      },
                                      "children": [
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-number selfRef",
                                            "href": "#section-21.1.3.3",
                                          },
                                          "children": [
                                            {
                                              "textContent": "21.1.3.3. ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "attributes": {
                                            "class": "section-name selfRef",
                                            "href": "#name-limited-on-path-active-atta",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Limited On-Path Active Attacks",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
            ",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "h5",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.3-1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A limited on-path attacker is an off-path attacker that has offered improved
routing of packets by duplicating and forwarding original packets between the
server and the client, causing those packets to arrive before the original
copies such that the original packets are dropped by the destination endpoint.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.3-1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.3-2",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A limited on-path attacker differs from an on-path attacker in that it is not on
the original path between endpoints, and therefore the original packets sent by
an endpoint are still reaching their destination.  This means that a future
failure to route copied packets to the destination faster than their original
path will not prevent the original packets from reaching the destination.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.3-2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.3-3",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A limited on-path attacker can:",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.3-3",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "data-component": "HorizontalScrollable",
                                      },
                                      "children": [
                                        {
                                          "attributes": {
                                            "class": "normal",
                                          },
                                          "children": [
                                            {
                                              "textContent": "
",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.3-4.1",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Inspect packets",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.3-4.1",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.3-4.2",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Inject new packets",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.3-4.2",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.3-4.3",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Modify unencrypted packet headers",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.3-4.3",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.3-4.4",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Reorder packets",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.3-4.4",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
            ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "ul",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.3-5",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A limited on-path attacker cannot:",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.3-5",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "data-component": "HorizontalScrollable",
                                      },
                                      "children": [
                                        {
                                          "attributes": {
                                            "class": "normal",
                                          },
                                          "children": [
                                            {
                                              "textContent": "
",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.3-6.1",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Delay packets so that they arrive later than packets sent on the original path",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.3-6.1",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.3-6.2",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Drop packets",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.3-6.2",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "class": "normal",
                                                "id": "section-21.1.3.3-6.3",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "Modify the authenticated and encrypted portion of a packet and cause the
 recipient to accept that packet",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.3-6.3",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
            ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "ul",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.3-7",
                                      },
                                      "children": [
                                        {
                                          "textContent": "A limited on-path attacker can only delay packets up to the point that the
original packets arrive before the duplicate packets, meaning that it cannot
offer routing with worse latency than the original path.  If a limited on-path
attacker drops packets, the original copy will still arrive at the destination
endpoint.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.3-7",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.3-8",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC aims to constrain the capabilities of a limited off-path attacker as
follows:",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.3-8",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "data-component": "HorizontalScrollable",
                                      },
                                      "children": [
                                        {
                                          "attributes": {
                                            "class": "normal type-1",
                                            "id": "section-21.1.3.3-9",
                                            "start": "1",
                                            "type": "1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.3-9.1",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "A limited on-path attacker cannot cause a connection to close once the
handshake has completed.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.3-9.1",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.3-9.2",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "A limited on-path attacker cannot cause an idle connection to close if the
client is first to resume activity.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.3-9.2",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
              ",
                                              "type": "Text",
                                            },
                                            {
                                              "attributes": {
                                                "id": "section-21.1.3.3-9.3",
                                              },
                                              "children": [
                                                {
                                                  "textContent": "A limited on-path attacker can cause an idle connection to be deemed lost if
the server is the first to resume activity.",
                                                  "type": "Text",
                                                },
                                                {
                                                  "attributes": {
                                                    "class": "pilcrow",
                                                    "href": "#section-21.1.3.3-9.3",
                                                  },
                                                  "children": [
                                                    {
                                                      "textContent": "¶",
                                                      "type": "Text",
                                                    },
                                                  ],
                                                  "nodeName": "a",
                                                  "type": "Element",
                                                },
                                                {
                                                  "textContent": "
",
                                                  "type": "Text",
                                                },
                                              ],
                                              "nodeName": "li",
                                              "type": "Element",
                                            },
                                            {
                                              "textContent": "
            ",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "ol",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "div",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-21.1.3.3-10",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Note that these guarantees are the same guarantees provided for any NAT, for the
same reasons.",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.1.3.3-10",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                      ],
                                      "nodeName": "p",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "section",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "handshake-dos",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.2",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-handshake-denial-of-service",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.2",
                          },
                          "children": [
                            {
                              "textContent": "21.2. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-handshake-denial-of-service",
                          },
                          "children": [
                            {
                              "textContent": "Handshake Denial of Service",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.2-1",
                      },
                      "children": [
                        {
                          "textContent": "As an encrypted and authenticated transport, QUIC provides a range of
protections against denial of service.  Once the cryptographic handshake is
complete, QUIC endpoints discard most packets that are not authenticated,
greatly limiting the ability of an attacker to interfere with existing
connections.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.2-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.2-2",
                      },
                      "children": [
                        {
                          "textContent": "Once a connection is established, QUIC endpoints might accept some
unauthenticated ICMP packets (see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#pmtud",
                          },
                          "children": [
                            {
                              "textContent": "Section 14.2.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "), but the use of these packets is
extremely limited.  The only other type of packet that an endpoint might accept
is a stateless reset (",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#stateless-reset",
                          },
                          "children": [
                            {
                              "textContent": "Section 10.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "), which relies on the token being kept
secret until it is used.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.2-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.2-3",
                      },
                      "children": [
                        {
                          "textContent": "During the creation of a connection, QUIC only provides protection against
attacks from off the network path.  All QUIC packets contain proof that the
recipient saw a preceding packet from its peer.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.2-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.2-4",
                      },
                      "children": [
                        {
                          "textContent": "Addresses cannot change during the handshake, so endpoints can discard packets
that are received on a different network path.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.2-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.2-5",
                      },
                      "children": [
                        {
                          "textContent": "The Source and Destination Connection ID fields are the primary means of
protection against an off-path attack during the handshake; see
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#validate-handshake",
                          },
                          "children": [
                            {
                              "textContent": "Section 8.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".  These are required to match those set by a peer.
Except for Initial and Stateless Resets, an endpoint only accepts packets that
include a Destination Connection ID field that matches a value the endpoint
previously chose.  This is the only protection offered for Version Negotiation
packets.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.2-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.2-6",
                      },
                      "children": [
                        {
                          "textContent": "The Destination Connection ID field in an Initial packet is selected by a client
to be unpredictable, which serves an additional purpose.  The packets that carry
the cryptographic handshake are protected with a key that is derived from this
connection ID and a salt specific to the QUIC version.  This allows endpoints to
use the same process for authenticating packets that they receive as they use
after the cryptographic handshake completes.  Packets that cannot be
authenticated are discarded.  Protecting packets in this fashion provides a
strong assurance that the sender of the packet saw the Initial packet and
understood it.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.2-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.2-7",
                      },
                      "children": [
                        {
                          "textContent": "These protections are not intended to be effective against an attacker that is
able to receive QUIC packets prior to the connection being established.  Such an
attacker can potentially send packets that will be accepted by QUIC endpoints.
This version of QUIC attempts to detect this sort of attack, but it expects that
endpoints will fail to establish a connection rather than recovering.  For the
most part, the cryptographic handshake protocol ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#QUIC-TLS",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC-TLS",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " is responsible for
detecting tampering during the handshake.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.2-7",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.2-8",
                      },
                      "children": [
                        {
                          "textContent": "Endpoints are permitted to use other methods to detect and attempt to recover
from interference with the handshake.  Invalid packets can be identified and
discarded using other methods, but no specific method is mandated in this
document.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.2-8",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "amplification-attack",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.3",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-amplification-attack",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.3",
                          },
                          "children": [
                            {
                              "textContent": "21.3. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-amplification-attack",
                          },
                          "children": [
                            {
                              "textContent": "Amplification Attack",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.3-1",
                      },
                      "children": [
                        {
                          "textContent": "An attacker might be able to receive an address validation token
(",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#address-validation",
                          },
                          "children": [
                            {
                              "textContent": "Section 8",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ") from a server and then release the IP address it used
to acquire that token.  At a later time, the attacker can initiate a 0-RTT
connection with a server by spoofing this same address, which might now address
a different (victim) endpoint.  The attacker can thus potentially cause the
server to send an initial congestion window's worth of data towards the victim.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.3-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.3-2",
                      },
                      "children": [
                        {
                          "textContent": "Servers ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " provide mitigations for this attack by limiting the usage and
lifetime of address validation tokens; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#validate-future",
                          },
                          "children": [
                            {
                              "textContent": "Section 8.1.3",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.3-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "optimistic-ack-attack",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.4",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-optimistic-ack-attack",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.4",
                          },
                          "children": [
                            {
                              "textContent": "21.4. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-optimistic-ack-attack",
                          },
                          "children": [
                            {
                              "textContent": "Optimistic ACK Attack",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.4-1",
                      },
                      "children": [
                        {
                          "textContent": "An endpoint that acknowledges packets it has not received might cause a
congestion controller to permit sending at rates beyond what the network
supports.  An endpoint ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MAY",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " skip packet numbers when sending packets to detect
this behavior.  An endpoint can then immediately close the connection with a
connection error of type PROTOCOL",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_VIOLATION;",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#immediate-close",
                          },
                          "children": [
                            {
                              "textContent": "Section 10.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.4-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "request-forgery-attacks",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.5",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-request-forgery-attacks",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.5",
                          },
                          "children": [
                            {
                              "textContent": "21.5. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-request-forgery-attacks",
                          },
                          "children": [
                            {
                              "textContent": "Request Forgery Attacks",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.5-1",
                      },
                      "children": [
                        {
                          "textContent": "A request forgery attack occurs where an endpoint causes its peer to issue a
request towards a victim, with the request controlled by the endpoint. Request
forgery attacks aim to provide an attacker with access to capabilities of its
peer that might otherwise be unavailable to the attacker. For a networking
protocol, a request forgery attack is often used to exploit any implicit
authorization conferred on the peer by the victim due to the peer's location in
the network.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.5-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.5-2",
                      },
                      "children": [
                        {
                          "textContent": "For request forgery to be effective, an attacker needs to be able to influence
what packets the peer sends and where these packets are sent. If an attacker
can target a vulnerable service with a controlled payload, that service might
perform actions that are attributed to the attacker's peer but are decided by
the attacker.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.5-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.5-3",
                      },
                      "children": [
                        {
                          "textContent": "For example, cross-site request forgery ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#CSRF",
                              },
                              "children": [
                                {
                                  "textContent": "CSRF",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": "
exploits on the Web cause a client to issue requests that include authorization
cookies ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#COOKIE",
                              },
                              "children": [
                                {
                                  "textContent": "COOKIE",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": ", allowing one site access to information and
actions that are intended to be restricted to a different site.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.5-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.5-4",
                      },
                      "children": [
                        {
                          "textContent": "As QUIC runs over UDP, the primary attack modality of concern is one where an
attacker can select the address to which its peer sends UDP datagrams and can
control some of the unprotected content of those packets. As much of the data
sent by QUIC endpoints is protected, this includes control over ciphertext. An
attack is successful if an attacker can cause a peer to send a UDP datagram to
a host that will perform some action based on content in the datagram.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.5-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.5-5",
                      },
                      "children": [
                        {
                          "textContent": "This section discusses ways in which QUIC might be used for request forgery
attacks.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.5-5",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.5-6",
                      },
                      "children": [
                        {
                          "textContent": "This section also describes limited countermeasures that can be implemented by
QUIC endpoints. These mitigations can be employed unilaterally by a QUIC
implementation or deployment, without potential targets for request forgery
attacks taking action. However, these countermeasures could be insufficient if
UDP-based services do not properly authorize requests.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.5-6",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.5-7",
                      },
                      "children": [
                        {
                          "textContent": "Because the migration attack described in
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#request-forgery-with-spoofed-migration",
                          },
                          "children": [
                            {
                              "textContent": "Section 21.5.4",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": " is quite powerful and does not have
adequate countermeasures",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": ",",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " QUIC server implementations should assume that
attackers can cause them to generate arbitrary UDP payloads to arbitrary
destinations. QUIC servers ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be deployed in networks that do not deploy
ingress filtering ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#BCP38",
                              },
                              "children": [
                                {
                                  "textContent": "BCP38",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " and also have inadequately secured UDP endpoints.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.5-7",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.5-8",
                      },
                      "children": [
                        {
                          "textContent": "Although it is not generally possible to ensure that clients are not co-located
with vulnerable endpoints, this version of QUIC does not allow servers to
migrate, thus preventing spoofed migration attacks on clients.  Any future
extension that allows server migration ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " also define countermeasures for
forgery attacks.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.5-8",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "control-options-for-endpoints",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-21.5.1",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-control-options-for-endpoin",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-21.5.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "21.5.1. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-control-options-for-endpoin",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Control Options for Endpoints",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.1-1",
                              },
                              "children": [
                                {
                                  "textContent": "QUIC offers some opportunities for an attacker to influence or control where
its peer sends UDP datagrams:",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.1-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "data-component": "HorizontalScrollable",
                              },
                              "children": [
                                {
                                  "attributes": {
                                    "class": "normal",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "normal",
                                        "id": "section-21.5.1-2.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "initial connection establishment (",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#handshake",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 7",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "), where a server is able to
choose where a client sends datagrams -- for example, by populating DNS
records;",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.5.1-2.1",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "li",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "normal",
                                        "id": "section-21.5.1-2.2",
                                      },
                                      "children": [
                                        {
                                          "textContent": "preferred addresses (",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#preferred-address",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 9.6",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "), where a server is able to choose
where a client sends datagrams;",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.5.1-2.2",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "li",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "normal",
                                        "id": "section-21.5.1-2.3",
                                      },
                                      "children": [
                                        {
                                          "textContent": "spoofed connection migrations (",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#address-spoofing",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 9.3.1",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "), where a client is able
to use source address spoofing to select where a server sends subsequent
datagrams; and",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.5.1-2.3",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "li",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
            ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "normal",
                                        "id": "section-21.5.1-2.4",
                                      },
                                      "children": [
                                        {
                                          "textContent": "spoofed packets that cause a server to send a Version Negotiation packet
(",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "xref",
                                            "href": "#vn-spoofing",
                                          },
                                          "children": [
                                            {
                                              "textContent": "Section 21.5.5",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": ").",
                                          "type": "Text",
                                        },
                                        {
                                          "attributes": {
                                            "class": "pilcrow",
                                            "href": "#section-21.5.1-2.4",
                                          },
                                          "children": [
                                            {
                                              "textContent": "¶",
                                              "type": "Text",
                                            },
                                          ],
                                          "nodeName": "a",
                                          "type": "Element",
                                        },
                                        {
                                          "textContent": "
",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "li",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "
          ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "ul",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "div",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.1-3",
                              },
                              "children": [
                                {
                                  "textContent": "In all cases, the attacker can cause its peer to send datagrams to a
victim that might not understand QUIC. That is, these packets are sent by
the peer prior to address validation; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#address-validation",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 8",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.1-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.1-4",
                              },
                              "children": [
                                {
                                  "textContent": "Outside of the encrypted portion of packets, QUIC offers an endpoint several
options for controlling the content of UDP datagrams that its peer sends. The
Destination Connection ID field offers direct control over bytes that appear
early in packets sent by the peer; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#connection-id",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 5.1",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ". The Token field in
Initial packets offers a server control over other bytes of Initial packets;
see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#packet-initial",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2.2",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.1-4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.1-5",
                              },
                              "children": [
                                {
                                  "textContent": "There are no measures in this version of QUIC to prevent indirect control over
the encrypted portions of packets. It is necessary to assume that endpoints are
able to control the contents of frames that a peer sends, especially those
frames that convey application data, such as STREAM frames. Though this depends
to some degree on details of the application protocol, some control is possible
in many protocol usage contexts. As the attacker has access to packet
protection keys, they are likely to be capable of predicting how a peer will
encrypt future packets. Successful control over datagram content then only
requires that the attacker be able to predict the packet number and placement
of frames in packets with some amount of reliability.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.1-5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.1-6",
                              },
                              "children": [
                                {
                                  "textContent": "This section assumes that limiting control over datagram content is not
feasible. The focus of the mitigations in subsequent sections is on limiting
the ways in which datagrams that are sent prior to address validation can be
used for request forgery.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.1-6",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "request-forgery-with-client-initial-packets",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-21.5.2",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-request-forgery-with-client",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-21.5.2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "21.5.2. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-request-forgery-with-client",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Request Forgery with Client Initial Packets",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.2-1",
                              },
                              "children": [
                                {
                                  "textContent": "An attacker acting as a server can choose the IP address and port on which it
advertises its availability, so Initial packets from clients are assumed to be
available for use in this sort of attack. The address validation implicit in the
handshake ensures that -- for a new connection -- a client will not send other
types of packets to a destination that does not understand QUIC or is not
willing to accept a QUIC connection.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.2-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.2-2",
                              },
                              "children": [
                                {
                                  "textContent": "Initial packet protection (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc9001/#section-5.2",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 5.2",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#QUIC-TLS",
                                      },
                                      "children": [
                                        {
                                          "textContent": "QUIC-TLS",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") makes it difficult for
servers to control the content of Initial packets sent by clients. A client
choosing an unpredictable Destination Connection ID ensures that servers are
unable to control any of the encrypted portion of Initial packets from clients.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.2-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.2-3",
                              },
                              "children": [
                                {
                                  "textContent": "However, the Token field is open to server control and does allow a server to
use clients to mount request forgery attacks. The use of tokens provided with
the NEW_TOKEN frame (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#validate-future",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 8.1.3",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") offers the only option for request
forgery during connection establishment.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.2-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.2-4",
                              },
                              "children": [
                                {
                                  "textContent": "Clients, however, are not obligated to use the NEW_TOKEN frame. Request forgery
attacks that rely on the Token field can be avoided if clients send an empty
Token field when the server address has changed from when the NEW_TOKEN frame
was received.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.2-4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.2-5",
                              },
                              "children": [
                                {
                                  "textContent": "Clients could avoid using NEW_TOKEN if the server address changes. However, not
including a Token field could adversely affect performance. Servers could rely
on NEW_TOKEN to enable the sending of data in excess of the three-times limit on
sending data; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#validate-handshake",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 8.1",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ". In particular, this affects cases
where clients use 0-RTT to request data from servers.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.2-5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.2-6",
                              },
                              "children": [
                                {
                                  "textContent": "Sending a Retry packet (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#packet-retry",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2.5",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") offers a server the option to change
the Token field. After sending a Retry, the server can also control the
Destination Connection ID field of subsequent Initial packets from the client.
This also might allow indirect control over the encrypted content of Initial
packets. However, the exchange of a Retry packet validates the server's
address, thereby preventing the use of subsequent Initial packets for request
forgery.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.2-6",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "forgery-spa",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-21.5.3",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-request-forgery-with-prefer",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-21.5.3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "21.5.3. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-request-forgery-with-prefer",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Request Forgery with Preferred Addresses",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.3-1",
                              },
                              "children": [
                                {
                                  "textContent": "Servers can specify a preferred address, which clients then migrate to after
confirming the handshake; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#preferred-address",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 9.6",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ". The Destination Connection
ID field of packets that the client sends to a preferred address can be used
for request forgery.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.3-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.3-2",
                              },
                              "children": [
                                {
                                  "textContent": "A client ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MUST NOT",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " send non-probing frames to a preferred address prior to
validating that address; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#address-validation",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 8",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ". This greatly reduces the
options that a server has to control the encrypted portion of datagrams.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.3-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.3-3",
                              },
                              "children": [
                                {
                                  "textContent": "This document does not offer any additional countermeasures that are specific to
the use of preferred addresses and can be implemented by endpoints. The generic
measures described in ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#forgery-generic",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 21.5.6",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " could be used as further mitigation.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.3-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "request-forgery-with-spoofed-migration",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-21.5.4",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-request-forgery-with-spoofe",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-21.5.4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "21.5.4. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-request-forgery-with-spoofe",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Request Forgery with Spoofed Migration",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.4-1",
                              },
                              "children": [
                                {
                                  "textContent": "Clients are able to present a spoofed source address as part of an apparent
connection migration to cause a server to send datagrams to that address.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.4-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.4-2",
                              },
                              "children": [
                                {
                                  "textContent": "The Destination Connection ID field in any packets that a server subsequently
sends to this spoofed address can be used for request forgery. A client might
also be able to influence the ciphertext.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.4-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.4-3",
                              },
                              "children": [
                                {
                                  "textContent": "A server that only sends probing packets (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#probing",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 9.1",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") to an address prior to
address validation provides an attacker with only limited control over the
encrypted portion of datagrams. However, particularly for NAT rebinding, this
can adversely affect performance. If the server sends frames carrying
application data, an attacker might be able to control most of the content of
datagrams.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.4-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.4-4",
                              },
                              "children": [
                                {
                                  "textContent": "This document does not offer specific countermeasures that can be implemented by
endpoints, aside from the generic measures described in ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#forgery-generic",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 21.5.6",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ".
However, countermeasures for address spoofing at the network level -- in
particular, ingress filtering ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "[",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#BCP38",
                                      },
                                      "children": [
                                        {
                                          "textContent": "BCP38",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " -- are especially effective against
attacks that use spoofing and originate from an external network.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.4-4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "vn-spoofing",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-21.5.5",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-request-forgery-with-versio",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-21.5.5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "21.5.5. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-request-forgery-with-versio",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Request Forgery with Version Negotiation",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.5-1",
                              },
                              "children": [
                                {
                                  "textContent": "Clients that are able to present a spoofed source address on a packet can cause
a server to send a Version Negotiation packet (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#packet-version",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 17.2.1",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") to that
address.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.5-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.5-2",
                              },
                              "children": [
                                {
                                  "textContent": "The absence of size restrictions on the connection ID fields for packets of an
unknown version increases the amount of data that the client controls from the
resulting datagram.  The first byte of this packet is not under client control
and the next four bytes are zero, but the client is able to control up to 512
bytes starting from the fifth byte.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.5-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.5-3",
                              },
                              "children": [
                                {
                                  "textContent": "No specific countermeasures are provided for this attack, though generic
protections (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#forgery-generic",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 21.5.6",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") could apply.  In this case, ingress filtering
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "[",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#BCP38",
                                      },
                                      "children": [
                                        {
                                          "textContent": "BCP38",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " is also effective.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.5-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "forgery-generic",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-21.5.6",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-generic-request-forgery-cou",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-21.5.6",
                                  },
                                  "children": [
                                    {
                                      "textContent": "21.5.6. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-generic-request-forgery-cou",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Generic Request Forgery Countermeasures",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.6-1",
                              },
                              "children": [
                                {
                                  "textContent": "The most effective defense against request forgery attacks is to modify
vulnerable services to use strong authentication. However, this is not always
something that is within the control of a QUIC deployment. This section outlines
some other steps that QUIC endpoints could take unilaterally. These additional
steps are all discretionary because, depending on circumstances, they could
interfere with or prevent legitimate uses.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.6-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.6-2",
                              },
                              "children": [
                                {
                                  "textContent": "Services offered over loopback interfaces often lack proper authentication.
Endpoints ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " prevent connection attempts or migration to a loopback address.
Endpoints ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD NOT",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " allow connections or migration to a loopback address if the
same service was previously available at a different interface or if the address
was provided by a service at a non-loopback address. Endpoints that depend on
these capabilities could offer an option to disable these protections.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.6-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.6-3",
                              },
                              "children": [
                                {
                                  "textContent": "Similarly, endpoints could regard a change in address to a link-local address
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "[",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#RFC4291",
                                      },
                                      "children": [
                                        {
                                          "textContent": "RFC4291",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " or an address in a private-use range ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "[",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#RFC1918",
                                      },
                                      "children": [
                                        {
                                          "textContent": "RFC1918",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " from a global,
unique-local ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "textContent": "[",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#RFC4193",
                                      },
                                      "children": [
                                        {
                                          "textContent": "RFC4193",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ", or non-private address as a potential attempt at
request forgery. Endpoints could refuse to use these addresses entirely, but
that carries a significant risk of interfering with legitimate uses. Endpoints
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD NOT",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " refuse to use an address unless they have specific knowledge about
the network indicating that sending datagrams to unvalidated addresses in a
given range is not safe.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.6-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.6-4",
                              },
                              "children": [
                                {
                                  "textContent": "Endpoints ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " choose to reduce the risk of request forgery by not including
values from NEW_TOKEN frames in Initial packets or by only sending probing
frames in packets prior to completing address validation. Note that this does
not prevent an attacker from using the Destination Connection ID field for an
attack.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.6-4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.6-5",
                              },
                              "children": [
                                {
                                  "textContent": "Endpoints are not expected to have specific information about the location of
servers that could be vulnerable targets of a request forgery attack. However,
it might be possible over time to identify specific UDP ports that are common
targets of attacks or particular patterns in datagrams that are used for
attacks. Endpoints ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " choose to avoid sending datagrams to these ports or not
send datagrams that match these patterns prior to validating the destination
address. Endpoints ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " retire connection IDs containing patterns known to be
problematic without using them.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-21.5.6-5",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-21.5.6-6",
                              },
                              "children": [
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-21.5.6-6.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Note: Modifying endpoints to apply these protections is more efficient than
  deploying network-based protections, as endpoints do not need to perform any
  additional processing when sending to an address that has been validated.",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "pilcrow",
                                        "href": "#section-21.5.6-6.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "¶",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                  ],
                                  "nodeName": "p",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "aside",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "section",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "div",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "slowloris-attacks",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.6",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-slowloris-attacks",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.6",
                          },
                          "children": [
                            {
                              "textContent": "21.6. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-slowloris-attacks",
                          },
                          "children": [
                            {
                              "textContent": "Slowloris Attacks",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.6-1",
                      },
                      "children": [
                        {
                          "textContent": "The attacks commonly known as Slowloris ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#SLOWLORIS",
                              },
                              "children": [
                                {
                                  "textContent": "SLOWLORIS",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " try to keep many
connections to the target endpoint open and hold them open as long as possible.
These attacks can be executed against a QUIC endpoint by generating the minimum
amount of activity necessary to avoid being closed for inactivity.  This might
involve sending small amounts of data, gradually opening flow control windows in
order to control the sender rate, or manufacturing ACK frames that simulate a
high loss rate.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.6-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.6-2",
                      },
                      "children": [
                        {
                          "textContent": "QUIC deployments ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " provide mitigations for the Slowloris attacks, such as
increasing the maximum number of clients the server will allow, limiting the
number of connections a single IP address is allowed to make, imposing
restrictions on the minimum transfer speed a connection is allowed to have, and
restricting the length of time an endpoint is allowed to stay connected.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.6-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "stream-fragmentation-and-reassembly-attacks",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.7",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-stream-fragmentation-and-re",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.7",
                          },
                          "children": [
                            {
                              "textContent": "21.7. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-stream-fragmentation-and-re",
                          },
                          "children": [
                            {
                              "textContent": "Stream Fragmentation and Reassembly Attacks",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.7-1",
                      },
                      "children": [
                        {
                          "textContent": "An adversarial sender might intentionally not send portions of the stream data,
causing the receiver to commit resources for the unsent data. This could
cause a disproportionat",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "e",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " receive buffer memory commitment and/or the creation of
a large and inefficient data structure at the receiver.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.7-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.7-2",
                      },
                      "children": [
                        {
                          "textContent": "An adversarial receiver might intentionally not acknowledge packets containing
stream data in an attempt to force the sender to store the unacknowledged stream
data for retransmission.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.7-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.7-3",
                      },
                      "children": [
                        {
                          "textContent": "The attack on receivers is mitigated if flow control windows correspond to
available memory.  However, some receivers will overcommit memory and advertise
flow control offsets in the aggregate that exceed actual available memory.  The
overcommitment strategy can lead to better performance when endpoints are well
behaved, but renders endpoints vulnerable to the stream fragmentation attack.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.7-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.7-4",
                      },
                      "children": [
                        {
                          "textContent": "QUIC deployments ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " provide mitigations for stream fragmentation attacks.
Mitigations could consist of avoiding overcommitting memory, limiting the size
of tracking data structures, delaying reassembly of STREAM frames, implementing
heuristics based on the age and duration of reassembly holes, or some
combination of these.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.7-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "stream-commitment-attack",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.8",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-stream-commitment-attack",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.8",
                          },
                          "children": [
                            {
                              "textContent": "21.8. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-stream-commitment-attack",
                          },
                          "children": [
                            {
                              "textContent": "Stream Commitment Attack",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.8-1",
                      },
                      "children": [
                        {
                          "textContent": "An adversarial endpoint can open a large number of streams, exhausting state on
an endpoint.  The adversarial endpoint could repeat the process on a large
number of connections, in a manner similar to SYN flooding attacks in TCP.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.8-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.8-2",
                      },
                      "children": [
                        {
                          "textContent": "Normally, clients will open streams sequentially, as explained in ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#stream-id",
                          },
                          "children": [
                            {
                              "textContent": "Section 2.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".
However, when several streams are initiated at short intervals, loss or
reordering can cause STREAM frames that open streams to be received out of
sequence.  On receiving a higher-numbered stream ID, a receiver is required to
open all intervening streams of the same type; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#stream-recv-states",
                          },
                          "children": [
                            {
                              "textContent": "Section 3.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".
Thus, on a new connection, opening stream 4000000 opens 1 million and 1
client",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "-initiated",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " bidirectional streams.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.8-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.8-3",
                      },
                      "children": [
                        {
                          "textContent": "The number of active streams is limited by the initial",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_max",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_streams",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_bidi",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " and
initial",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_max",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_streams",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "_uni",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " transport parameters as updated by any received
MAX_STREAMS frames, as explained in
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#controlling-concurrency",
                          },
                          "children": [
                            {
                              "textContent": "Section 4.6",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".  If chosen judiciously, these limits mitigate the
effect of the stream commitment attack.  However, setting the limit too low
could affect performance when applications expect to open a large number of
streams.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.8-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "useless",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.9",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-peer-denial-of-service",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.9",
                          },
                          "children": [
                            {
                              "textContent": "21.9. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-peer-denial-of-service",
                          },
                          "children": [
                            {
                              "textContent": "Peer Denial of Service",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.9-1",
                      },
                      "children": [
                        {
                          "textContent": "QUIC and TLS both contain frames or messages that have legitimate uses in some
contexts, but these frames or messages can be abused to cause a peer to expend
processing resources without having any observable impact on the state of the
connection.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.9-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.9-2",
                      },
                      "children": [
                        {
                          "textContent": "Messages can also be used to change and revert state in small or inconsequential
ways, such as by sending small increments to flow control limits.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.9-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.9-3",
                      },
                      "children": [
                        {
                          "textContent": "If processing costs are disproportionat",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "ely",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " large in comparison to bandwidth
consumption or effect on state, then this could allow a malicious peer to
exhaust processing capacity.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.9-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.9-4",
                      },
                      "children": [
                        {
                          "textContent": "While there are legitimate uses for all messages, implementations ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "SHOULD",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " track
cost of processing relative to progress and treat excessive quantities of any
non-productive packets as indicative of an attack.  Endpoints ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MAY",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " respond to
this condition with a connection error or by dropping packets.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.9-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "security-ecn",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.10",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-explicit-congestion-notifica",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.10",
                          },
                          "children": [
                            {
                              "textContent": "21.10. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-explicit-congestion-notifica",
                          },
                          "children": [
                            {
                              "textContent": "Explicit Congestion Notification Attacks",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.10-1",
                      },
                      "children": [
                        {
                          "textContent": "An on-path attacker could manipulate the value of ECN fields in the IP header
to influence the sender's rate. ",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [
                            {
                              "textContent": "[",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "xref",
                                "href": "#RFC3168",
                              },
                              "children": [
                                {
                                  "textContent": "RFC3168",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "a",
                              "type": "Element",
                            },
                            {
                              "textContent": "]",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " discusses manipulations and their
effects in more detail.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.10-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.10-2",
                      },
                      "children": [
                        {
                          "textContent": "A limited on-path attacker can duplicate and send packets with modified ECN
fields to affect the sender's rate. If duplicate packets are discarded by a
receiver, an attacker will need to race the duplicate packet against the
original to be successful in this attack. Therefore, QUIC endpoints ignore the
ECN field in an IP packet unless at least one QUIC packet in that IP packet is
successfully processed; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#ecn",
                          },
                          "children": [
                            {
                              "textContent": "Section 13.4",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.10-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "reset-oracle",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.11",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-stateless-reset-oracle",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.11",
                          },
                          "children": [
                            {
                              "textContent": "21.11. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-stateless-reset-oracle",
                          },
                          "children": [
                            {
                              "textContent": "Stateless Reset Oracle",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.11-1",
                      },
                      "children": [
                        {
                          "textContent": "Stateless resets create a possible denial",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "-of",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": "-service",
                          "type": "Text",
                        },
                        {
                          "attributes": {},
                          "children": [],
                          "nodeName": "wbr",
                          "type": "Element",
                        },
                        {
                          "textContent": " attack analogous to a TCP
reset injection. This attack is possible if an attacker is able to cause a
stateless reset token to be generated for a connection with a selected
connection ID. An attacker that can cause this token to be generated can reset
an active connection with the same connection ID.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.11-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.11-2",
                      },
                      "children": [
                        {
                          "textContent": "If a packet can be routed to different instances that share a static key -- for
example, by changing an IP address or port -- then an attacker can cause the
server to send a stateless reset.  To defend against this style of denial of
service, endpoints that share a static key for stateless resets (see
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#reset-token",
                          },
                          "children": [
                            {
                              "textContent": "Section 10.3.2",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ") ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " be arranged so that packets with a given connection ID
always arrive at an instance that has connection state, unless that connection
is no longer active.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.11-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.11-3",
                      },
                      "children": [
                        {
                          "textContent": "More generally, servers ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST NOT",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " generate a stateless reset if a connection with
the corresponding connection ID could be active on any endpoint using the same
static key.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.11-3",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.11-4",
                      },
                      "children": [
                        {
                          "textContent": "In the case of a cluster that uses dynamic load balancing, it is possible that a
change in load-balancer configuration could occur while an active instance
retains connection state.  Even if an instance retains connection state, the
change in routing and resulting stateless reset will result in the connection
being terminated.  If there is no chance of the packet being routed to the
correct instance, it is better to send a stateless reset than wait for the
connection to time out.  However, this is acceptable only if the routing cannot
be influenced by an attacker.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.11-4",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "version-downgrade",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.12",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-version-downgrade",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.12",
                          },
                          "children": [
                            {
                              "textContent": "21.12. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-version-downgrade",
                          },
                          "children": [
                            {
                              "textContent": "Version Downgrade",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.12-1",
                      },
                      "children": [
                        {
                          "textContent": "This document defines QUIC Version Negotiation packets
(",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#version-negotiation",
                          },
                          "children": [
                            {
                              "textContent": "Section 6",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "), which can be used to negotiate the QUIC version used
between two endpoints. However, this document does not specify how this
negotiation will be performed between this version and subsequent future
versions.  In particular, Version Negotiation packets do not contain any
mechanism to prevent version downgrade attacks.  Future versions of QUIC that
use Version Negotiation packets ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "bcp14",
                          },
                          "children": [
                            {
                              "textContent": "MUST",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "span",
                          "type": "Element",
                        },
                        {
                          "textContent": " define a mechanism that is robust against
version downgrade attacks.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.12-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "targeted-attacks-by-routing",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.13",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-targeted-attacks-by-routing",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.13",
                          },
                          "children": [
                            {
                              "textContent": "21.13. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-targeted-attacks-by-routing",
                          },
                          "children": [
                            {
                              "textContent": "Targeted Attacks by Routing",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.13-1",
                      },
                      "children": [
                        {
                          "textContent": "Deployments should limit the ability of an attacker to target a new connection
to a particular server instance.  Ideally, routing decisions are made
independently of client-selected values, including addresses.  Once an instance
is selected, a connection ID can be selected so that later packets are routed to
the same instance.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.13-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "traffic-analysis",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-21.14",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-traffic-analysis",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-21.14",
                          },
                          "children": [
                            {
                              "textContent": "21.14. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-traffic-analysis",
                          },
                          "children": [
                            {
                              "textContent": "Traffic Analysis",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.14-1",
                      },
                      "children": [
                        {
                          "textContent": "The length of QUIC packets can reveal information about the length of the
content of those packets.  The PADDING frame is provided so that endpoints have
some ability to obscure the length of packet content; see ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#frame-padding",
                          },
                          "children": [
                            {
                              "textContent": "Section 19.1",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ".",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.14-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-21.14-2",
                      },
                      "children": [
                        {
                          "textContent": "Defeating traffic analysis is challenging and the subject of active research.
Length is not the only way that information might leak.  Endpoints might also
reveal sensitive information through other side channels, such as the timing of
packets.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-21.14-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "section",
                  "type": "Element",
                },
                {
                  "textContent": "
",
                  "type": "Text",
                },
              ],
              "nodeName": "div",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
          ],
          "nodeName": "section",
          "type": "Element",
        },
        {
          "textContent": "
",
          "type": "Text",
        },
      ],
      "nodeName": "div",
      "type": "Element",
    },
    {
      "textContent": "
",
      "type": "Text",
    },
    {
      "attributes": {
        "id": "iana",
      },
      "children": [
        {
          "textContent": "
",
          "type": "Text",
        },
        {
          "attributes": {
            "id": "section-22",
          },
          "children": [
            {
              "textContent": "
      ",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "name-iana-considerations",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "section-number selfRef",
                    "href": "#section-22",
                  },
                  "children": [
                    {
                      "textContent": "22. ",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "attributes": {
                    "class": "section-name selfRef",
                    "href": "#name-iana-considerations",
                  },
                  "children": [
                    {
                      "textContent": "IANA Considerations",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": "
      ",
                  "type": "Text",
                },
              ],
              "nodeName": "h2",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "section-22-1",
              },
              "children": [
                {
                  "textContent": "This document establishes several registries for the management of codepoints in
QUIC.  These registries operate on a common set of policies as defined in
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "xref",
                    "href": "#iana-policy",
                  },
                  "children": [
                    {
                      "textContent": "Section 22.1",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
                {
                  "textContent": ".",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "class": "pilcrow",
                    "href": "#section-22-1",
                  },
                  "children": [
                    {
                      "textContent": "¶",
                      "type": "Text",
                    },
                  ],
                  "nodeName": "a",
                  "type": "Element",
                },
              ],
              "nodeName": "p",
              "type": "Element",
            },
            {
              "textContent": "
",
              "type": "Text",
            },
            {
              "attributes": {
                "id": "iana-policy",
              },
              "children": [
                {
                  "textContent": "
",
                  "type": "Text",
                },
                {
                  "attributes": {
                    "id": "section-22.1",
                  },
                  "children": [
                    {
                      "textContent": "
        ",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-registration-policies-for-q",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "section-number selfRef",
                            "href": "#section-22.1",
                          },
                          "children": [
                            {
                              "textContent": "22.1. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-registration-policies-for-q",
                          },
                          "children": [
                            {
                              "textContent": "Registration Policies for QUIC Registries",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-22.1-1",
                      },
                      "children": [
                        {
                          "textContent": "All QUIC registries allow for both provisional and permanent registration of
codepoints.  This section documents policies that are common to these
registries.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-22.1-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "iana-provisional",
                      },
                      "children": [
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-22.1.1",
                          },
                          "children": [
                            {
                              "textContent": "
          ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "name-provisional-registrations",
                              },
                              "children": [
                                {
                                  "textContent": "
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "section-number selfRef",
                                    "href": "#section-22.1.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "22.1.1. ",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "attributes": {
                                    "class": "section-name selfRef",
                                    "href": "#name-provisional-registrations",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Provisional Registrations",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
          ",
                                  "type": "Text",
                                },
                              ],
                              "nodeName": "h4",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.1-1",
                              },
                              "children": [
                                {
                                  "textContent": "Provisional registrations of codepoints are intended to allow for private use
and experimentation with extensions to QUIC.  Provisional registrations only
require the inclusion of the codepoint value and contact information.  However,
provisional registrations could be reclaimed and reassigned for another purpose.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.1-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.1-2",
                              },
                              "children": [
                                {
                                  "textContent": "Provisional registrations require Expert Review, as defined in ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [
                                    {
                                      "attributes": {
                                        "class": "relref",
                                        "href": "/info/rfc8126/#section-4.5",
                                      },
                                      "children": [
                                        {
                                          "textContent": "Section 4.5",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": " of [",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "class": "xref",
                                        "href": "#RFC8126",
                                      },
                                      "children": [
                                        {
                                          "textContent": "RFC8126",
                                          "type": "Text",
                                        },
                                      ],
                                      "nodeName": "a",
                                      "type": "Element",
                                    },
                                    {
                                      "textContent": "]",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ". The designated expert or experts are advised that only registrations
for an excessive proportion of remaining codepoint space or the very first
unassigned value (see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#iana-random",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 22.1.2",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ") can be rejected.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.1-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.1-3",
                              },
                              "children": [
                                {
                                  "textContent": "Provisional registrations will include a Date field that indicates when the
registration was last updated.  A request to update the date on any provisional
registration can be made without review from the designated expert(s).",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.1-3",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-22.1.1-4",
                              },
                              "children": [
                                {
                                  "textContent": "All QUIC registries include the following fields to support provisional
registration:",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-22.1.1-4",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "class": "break",
                              },
                              "children": [],
                              "nodeName": "span",
                              "type": "Element",
                            },
                            {
                              "attributes": {
                                "class": "dlParallel dlCompact",
                                "id": "section-22.1.1-5",
                              },
                              "children": [
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-22.1.1-5.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Value:",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "dt",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
            ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "id": "section-22.1.1-5.2",
                                    "style": "margin-left:1.5em",
                                  },
                                  "children": [
                                    {
                                      "textContent": "
              ",
                                      "type": "Text",
                                    },
                                    {
                                      "attributes": {
                                        "id": "section-22.1.1-5.2.1",
                                      },
                                      "children": [
                                        {
                                          "textContent": "The assigned codepoint.",
