                                "id": "section-20.1-2.8.1",
                              },
                              "children": [
                                {
                                  "textContent": "An endpoint received more data than it permitted in its advertised data
limits; see ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#flow-control",
                                  },
                                  "children": [
