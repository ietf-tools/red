                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-12.3-5.6.1",
                              },
                              "children": [
                                {
                                  "textContent": "All 0-RTT (",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#packet-0rtt",
                                  },
