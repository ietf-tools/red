          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-19.6-5.3",
                          },
                          "children": [
                            {
                              "textContent": "Length:",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dt",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-19.6-5.4",
                            "style": "margin-left:1.5em",
                          },
                          "children": [
                            {
                              "textContent": "
            ",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-19.6-5.4.1",
                              },
                              "children": [
                                {
                                  "textContent": "A variable-length integer specifying the length of the Crypto Data field in
this CRYPTO frame.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-19.6-5.4.1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "dd",
                          "type": "Element",
                        },
                        {
                          "textContent": "
          ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "break",
                          },
                          "children": [],
