                          "children": [
                            {
                              "textContent": "19.1. ",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "attributes": {
                            "class": "section-name selfRef",
                            "href": "#name-padding-frames",
                          },
                          "children": [
                            {
                              "textContent": "PADDING Frames",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": "
        ",
                          "type": "Text",
                        },
                      ],
                      "nodeName": "h3",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-19.1-1",
                      },
                      "children": [
                        {
                          "textContent": "A PADDING frame (type=0x00) has no semantic value.  PADDING frames can be used
to increase the size of a packet.  Padding can be used to increase an Initial
packet to the minimum required size or to provide protection against traffic
analysis for protected packets.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-19.1-1",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "section-19.1-2",
                      },
                      "children": [
                        {
                          "textContent": "PADDING frames are formatted as shown in ",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "xref",
                            "href": "#padding-format",
                          },
                          "children": [
                            {
                              "textContent": "Figure 23",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                        {
                          "textContent": ", which shows that
PADDING frames have no content. That is, a PADDING frame consists of the single
byte that identifies the frame as a PADDING frame.",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "class": "pilcrow",
                            "href": "#section-19.1-2",
                          },
                          "children": [
                            {
                              "textContent": "¶",
                              "type": "Text",
                            },
                          ],
                          "nodeName": "a",
                          "type": "Element",
                        },
                      ],
                      "nodeName": "p",
                      "type": "Element",
                    },
                    {
                      "textContent": "
",
                      "type": "Text",
                    },
                    {
                      "attributes": {
                        "id": "name-padding-frame-format",
                      },
                      "children": [],
                      "nodeName": "span",
                      "type": "Element",
