                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "
transport parameter in the TLS handshake.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-9.6.1-1",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-9.6.1-2",
                              },
                              "children": [
                                {
                                  "textContent": "Servers ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "MAY",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " communicate a preferred address of each address family (IPv4 and
IPv6) to allow clients to pick the one most suited to their network attachment.",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "pilcrow",
                                    "href": "#section-9.6.1-2",
                                  },
                                  "children": [
                                    {
                                      "textContent": "¶",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                              ],
                              "nodeName": "p",
                              "type": "Element",
                            },
                            {
                              "textContent": "
",
                              "type": "Text",
                            },
                            {
                              "attributes": {
                                "id": "section-9.6.1-3",
                              },
                              "children": [
                                {
                                  "textContent": "Once the handshake is confirmed, the client ",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "bcp14",
                                  },
                                  "children": [
                                    {
                                      "textContent": "SHOULD",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "span",
                                  "type": "Element",
                                },
                                {
                                  "textContent": " select one of the two
addresses provided by the server and initiate path validation (see
",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {
                                    "class": "xref",
                                    "href": "#migrate-validate",
                                  },
                                  "children": [
                                    {
                                      "textContent": "Section 8.2",
                                      "type": "Text",
                                    },
                                  ],
                                  "nodeName": "a",
                                  "type": "Element",
                                },
                                {
                                  "textContent": ").  A client constructs packets using any previously unused
active connection ID, taken from either the preferred",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
                                  "nodeName": "wbr",
                                  "type": "Element",
                                },
                                {
                                  "textContent": "_address",
                                  "type": "Text",
                                },
                                {
                                  "attributes": {},
                                  "children": [],
