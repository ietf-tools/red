                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-18.2-4.7",
                          },
                          "children": [
                            {
                              "textContent": "max",
                              "type": "Text",
                            },
                            {
                              "attributes": {},
                              "children": [],
                              "nodeName": "wbr",
