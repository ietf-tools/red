                        },
                        {
                          "textContent": "
",
                          "type": "Text",
                        },
                        {
                          "attributes": {
                            "id": "section-12.3-5.5",
                          },
                          "children": [
                            {
                              "textContent": "Application data space:",
                              "type": "Text",
                            },
