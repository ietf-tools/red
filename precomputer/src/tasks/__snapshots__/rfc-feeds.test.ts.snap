        </item>
        <item>
            <title><![CDATA[RFC 10008: The HTTP QUERY Method]]></title>
            <link>https://www.rfc-editor.org/info/rfc10008/</link>
            <guid isPermaLink="true">https://www.rfc-editor.org/info/rfc10008/</guid>
