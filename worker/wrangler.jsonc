/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rfced-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-16",
  "account_id": "57b7b70cdced62fd97661d0dc4ed1239",
  "workers_dev": false,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "destinations": ["heimdall-otlp"]
    }
  },
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "staging": {
      "routes": [{ "pattern": "www.staging.rfc-editor.org/*", "zone_name": "rfc-editor.org" }],
      "r2_buckets": [
        {
          "binding": "RFC_BUCKET",
          "bucket_name": "rpcstaging-rfc",
          "preview_bucket_name": "rpcstaging-rfc"
        },
        {
          "binding": "RED_BUCKET",
          "bucket_name": "red-staging",
          "preview_bucket_name": "red-staging"
        },
        {
          "binding": "INLINE_ERRATA_BUCKET",
          "bucket_name": "inline-errata",
          "preview_bucket_name": "inline-errata"
        }
      ],
      "vars": {
        "ENV_DOMAIN": ".staging",
        "NUXT_PUBLIC_TYPESENSE_HOST": "typesense.staging.ietf.org"
      }
    },
    "demo": {
      "routes": [{ "pattern": "www.demo.rfc-editor.org/*", "zone_name": "rfc-editor.org" }],
      "r2_buckets": [
        {
          "binding": "RFC_BUCKET",
          "bucket_name": "rfc-demo"
        },
        {
          "binding": "RED_BUCKET",
          "bucket_name": "red-demo"
        },
        {
          "binding": "INLINE_ERRATA_BUCKET",
          "bucket_name": "inline-errata",
          "preview_bucket_name": "inline-errata"
        }
      ],
      "vars": {
        "ENV_DOMAIN": ".demo",
        "NUXT_PUBLIC_TYPESENSE_HOST": "https://typesense.ietf.org"
      }
    },
    "production": {
      "routes": [{ "pattern": "www.rfc-editor.org/*", "zone_name": "rfc-editor.org" }],
      "r2_buckets": [
        {
          "binding": "RFC_BUCKET",
          "bucket_name": "shadow-rfc"
        },
        {
          "binding": "RED_BUCKET",
          "bucket_name": "red-prod"
        },
        {
          "binding": "INLINE_ERRATA_BUCKET",
          "bucket_name": "inline-errata",
          "preview_bucket_name": "inline-errata"
        }
      ],
      "vars": {
        "ENV_DOMAIN": "",
        "NUXT_PUBLIC_TYPESENSE_HOST": "https://typesense.ietf.org"
      }
    }
  }
}
